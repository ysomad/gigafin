[sqruff]
dialect = sqlite
max_line_length = 120
# sqlc macros and the FTS5 MATCH in queries/operations.sql do not parse; fix the rest
fix_even_unparsable = True
# AL03: sqlc names result fields after the expression, aliases would rename them
# RF01: sqlc.arg and sqlc.narg read as references to an unknown table
exclude_rules = AL03, RF01

# column types and constraints are aligned within CREATE TABLE
[sqruff:layout:type:data_type]
spacing_before = align
align_within = create_table_statement

[sqruff:layout:type:column_constraint_segment]
spacing_before = align
align_within = create_table_statement
