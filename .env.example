# Copy to .env; make loads it. Every setting is optional, defaults shown commented out.
# See internal/config for what each one does.

# SQLite database file
#DB_PATH=gigafin.db

# debug, info, warn or error
#LOGGER_LEVEL=info
#LOGGER_ADD_SOURCE=false

#HTTP_ADDR=127.0.0.1:8080
# true when served over HTTPS: Secure __Host- cookies and HSTS
#HTTP_SECURE_COOKIES=false
#HTTP_MAX_UPLOAD_BYTES=10485760
# 0 disables caching of static assets
#HTTP_STATIC_CACHE_TTL=1h

#SESSION_TTL=720h
#SESSION_IDLE_TTL=168h

# Go RE2 patterns matched against bank account names to pick the kind of a new account,
# empty disables the kind; defaults in internal/config/defaults.go
#IMPORT_ACCOUNT_LOAN_PATTERN=
#IMPORT_ACCOUNT_CREDIT_PATTERN=
#IMPORT_ACCOUNT_CASH_PATTERN=
#IMPORT_ACCOUNT_SAVINGS_PATTERN=
#IMPORT_ACCOUNT_DEBIT_PATTERN=

# 32 bytes in base64 (openssl rand -base64 32), encrypts bank sessions; empty disables bank sync
#BANKS_SECRET_KEY=
#BANKS_SYNC_INTERVAL=15m
#BANKS_SYNC_OVERLAP=1080h

# 32 bytes in base64 (openssl rand -base64 32), encrypts TOTP secrets; empty disables two-factor auth
#TOTP_SECRET_KEY=
