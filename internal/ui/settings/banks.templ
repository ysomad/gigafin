package settings

import (
	"fmt"
	"slices"
	"strconv"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/redact"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

// banksCard has a section per enabled bank: signing in to it and the accounts at it,
// or how to turn bank sync on. oob marks it for htmx to swap in out of band.
templ banksCard(v kit.Page, d banksData, oob bool) {
	<article
		id="settings-banks"
		class="card mb-4 form-compact"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h3>{ kit.T(ctx, "Banks") }</h3>
		for _, b := range d.Banks {
			@bankSection(v, d, b)
		}
		if len(d.Banks) == 0 {
			<p class="text-light">{ kit.T(ctx, "Set BANKS_SECRET_KEY (openssl rand -base64 32) and restart gigafin.") }</p>
		}
	</article>
}

// bankSection signs in to a bank by phone, then by the inputs the bank asks for, such
// as the SMS code and the password, or shows the connection and the accounts at the
// bank. Its header has the state of the connection and its actions.
templ bankSection(v kit.Page, d banksData, b bankData) {
	{{ name := kit.T(ctx, b.Bank.Name()) }}
	{{ base := "/settings/banks/" + string(b.Bank) }}
	{{ connected := b.Conn.Status == domain.BankConnected && b.Step == "" }}
	<section class="form-compact">
		<div class="hstack justify-between">
			<div class="hstack">
				<h4>{ name }</h4>
				if connected {
					<span class="badge" data-variant="success">{ kit.T(ctx, "Connected") }</span>
					<span class="badge outline">{ redact.Tail(b.Conn.Login, 4) }</span>
					if !b.Conn.LastSyncAt.IsZero() {
						<span class="badge outline" title={ kit.T(ctx, "Last sync: %s", kit.Datetime(ctx, b.Conn.LastSyncAt, v.User)) }><svg width="12" height="12" aria-hidden="true"><use href="/static/img/icons.svg#refresh-cw"></use></svg> { kit.Datetime(ctx, b.Conn.LastSyncAt, v.User) }</span>
					}
				} else if b.Conn.Status != "" && b.Step == "" {
					<span class="badge" data-variant="warning">{ kit.T(ctx, "Sign-in needed") }</span>
				}
			</div>
			if connected {
				{{ link := base + "/link" }}
				<div class="hstack">
					// posts the account table of the bank, linking the accounts not synced yet
					if slices.ContainsFunc(d.Accounts, func(t domain.BankAccount) bool { return t.Bank == b.Bank && t.AccountID == 0 }) {
						<button type="submit" form={ "form-" + string(b.Bank) + "-link" } formaction={ link } hx-post={ link } hx-swap="none" hx-disable="this" class="outline small">{ kit.T(ctx, "Sync all accounts") }</button>
					}
					<form method="post" action={ base + "/disconnect" } hx-post={ base + "/disconnect" } hx-swap="none" hx-confirm={ kit.T(ctx, "Disconnect %s? Synced operations stay.", name) }>
						<button type="submit" class="outline small" data-variant="danger">{ kit.T(ctx, "Disconnect") }</button>
					</form>
				</div>
			}
		</div>
		{{ form := string(b.Bank) }}
		if b.Step != "" {
			<p class="text-light">{ kit.T(ctx, "Signing in as %s.", b.Phone) }</p>
			<form id={ "form-" + form } method="post" action={ base + "/confirm" } class="row" hx-post={ base + "/confirm" } hx-swap="none" hx-disable="find button">
				@kit.FormError(v.Errors.Form(form), "col-12")
				{{ e := v.Errors.Get(form + ".value") }}
				{{ errID := form + "-value-error" }}
				switch b.Step {
					case domain.BankStepPassword:
						@kit.Field("col-3", kit.T(ctx, "Password"), e, errID, nil) {
							<input type="password" name="value" autocomplete="off" autofocus { kit.Invalid(e, errID)... }/>
						}
					case domain.BankStepOTP:
						@kit.Field("col-3", kit.T(ctx, "Code from SMS"), e, errID, nil) {
							<input name="value" inputmode="numeric" autocomplete="one-time-code" autofocus { kit.Invalid(e, errID)... }/>
						}
					default:
						@kit.Field("col-3", b.Step, e, errID, nil) {
							<input name="value" autocomplete="off" autofocus { kit.Invalid(e, errID)... }/>
						}
				}
				// cancel posts the form elsewhere, so it sits by Continue
				<div class="col-3 vstack gap-1">
					<label aria-hidden="true">&nbsp;</label>
					<div class="hstack">
						<button type="submit">{ kit.T(ctx, "Continue") }</button>
						<button type="submit" class="outline" data-variant="secondary" formaction={ base + "/cancel" } hx-post={ base + "/cancel" }>{ kit.T(ctx, "Cancel") }</button>
					</div>
				</div>
			</form>
		} else if !connected {
			<form id={ "form-" + form } method="post" action={ base + "/login" } class="row" hx-post={ base + "/login" } hx-swap="none" hx-disable="find button">
				@kit.FormError(v.Errors.Form(form), "col-12")
				{{ e := v.Errors.Get(form + ".phone") }}
				{{ errID := form + "-phone-error" }}
				@kit.Field("col-3", kit.T(ctx, "Phone"), e, errID, nil) {
					<input type="tel" name="phone" value={ b.Phone } placeholder="+79991234567" autocomplete="tel" { kit.Invalid(e, errID)... }/>
				}
				// the bank answers slowly, so the button spins
				<div class="col-3 vstack gap-1">
					<label aria-hidden="true">&nbsp;</label>
					<div>
						<button type="submit">{ kit.T(ctx, "Get SMS code") }</button>
					</div>
				</div>
			</form>
		} else {
			if b.Conn.LastError != "" {
				<p class="text-danger">{ kit.T(ctx, "Sync failed. Try again later") }</p>
			}
			@bankAccounts(v, d, b.Bank)
		}
	</section>
}

// bankAccounts lists the accounts at bank with the account each syncs with, or picks
// one for each not synced, a new one or an account of its currency, suggested first,
// for the sync button of the bank section to link.
templ bankAccounts(v kit.Page, d banksData, bank domain.Bank) {
	{{ link := "/settings/banks/" + string(bank) + "/link" }}
	<form id={ "form-" + string(bank) + "-link" } method="post" action={ link } class="form-compact">
		@kit.FormError(v.Errors.Form(string(bank)+"-link"), "")
		<div class="table">
			<table>
				<thead><tr><th>{ kit.T(ctx, "Account") }</th><th class="align-right">{ kit.T(ctx, "Balance") }</th><th class="align-right">{ kit.T(ctx, "Credit limit") }</th><th>{ kit.T(ctx, "Syncs with") }</th></tr></thead>
				<tbody>
					{{ n := 0 }}
					for _, t := range d.Accounts {
						if t.Bank == bank {
							{{ n++ }}
							<tr>
								<td>
									<div class="hstack gap-1">
										@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
										{ t.Name }
									</div>
								</td>
								<td class="align-right nowrap">{ kit.Money(ctx, t.Balance, t.Currency) } <span class="text-light">{ money.CurrencySymbol(t.Currency) }</span></td>
								<td class="align-right nowrap">
									if !t.CreditLimit.IsZero() {
										{ kit.Money(ctx, t.CreditLimit, t.Currency) } <span class="text-light">{ money.CurrencySymbol(t.Currency) }</span>
									}
								</td>
								<td>
									if a, ok := d.Linked[t.AccountID]; ok {
										<div class="hstack gap-1">
											<a class="badge" data-variant="success" href={ fmt.Sprintf("/accounts/%d", a.ID) }>✓ { a.Name }</a>
											if t.Mismatch(a) {
												@kit.BankBadge(t, a)
											}
										</div>
									} else {
										{{ id := strconv.FormatInt(t.ID, 10) }}
										<select name={ "account_" + id } aria-label={ kit.T(ctx, "Syncs with") }>
											<option value="new">{ kit.T(ctx, "New account") }</option>
											for _, a := range d.Choices[t.ID] {
												<option value={ a.ID } selected?={ a.ID == d.Suggested[t.ID] }>{ a.Name }</option>
											}
										</select>
									}
								</td>
							</tr>
						}
					}
					if n == 0 {
						@kit.EmptyRow(4, kit.T(ctx, "No accounts yet."))
					}
				</tbody>
			</table>
		</div>
	</form>
}

// bankLoginAlert shows msg, that banks ask to sign in again, linking to the banks card
// of the settings page; it tops the pages opened while a bank does not accept the
// session.
templ bankLoginAlert(msg string) {
	<div role="alert" data-variant="warning" class="mb-4">
		<span>
			{ msg }
			<a href="/settings#settings-banks">{ kit.T(ctx, "Sign in") }</a>
		</span>
	</div>
}
