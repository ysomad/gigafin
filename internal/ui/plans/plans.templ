package plans

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ plansPage(v kit.Page, d plansData) {
	@kit.Layout(v, false, nil) {
		<div class="hstack justify-between mb-6">
			<ot-dropdown>
				<menu class="buttons">
					<li><a class="button" href={ "/plans/new?month=" + d.Month.String() }>+ { kit.T(ctx, "New plan") }</a></li>
					<li>
						<button type="button" popovertarget="plan-actions" aria-label={ kit.T(ctx, "More actions") }>▾</button>
					</li>
				</menu>
				<menu popover id="plan-actions">
					<form method="post" action="/plans/fill">
						<input type="hidden" name="month" value={ d.Month.String() }/>
						<button type="submit" role="menuitem" class="ghost">{ kit.T(ctx, "Fill repeating plans into %s", d.Month) }</button>
					</form>
				</menu>
			</ot-dropdown>
			@kit.MonthNav("/plans", d.Month, d.Months, d.Prev, d.Next)
		</div>
		for _, sec := range d.Sections {
			{{ inc := sec.Kind == domain.KindIncome }}
			<section class="mb-6">
				<div class="hstack justify-between mb-2">
					<h3>{ kit.KindLabel(ctx, sec.Kind) }</h3>
					<div class="vstack gap-1 align-right">
						for _, tot := range sec.Totals {
							<span>
								{ kit.Money(ctx, tot.Spent, tot.Currency) } <span class="text-light">{ kit.T(ctx, "of") } { kit.Money(ctx, tot.Plan, tot.Currency) } { money.CurrencySymbol(tot.Currency) } ·</span>
								{ kit.Money(ctx, tot.Left().Abs(), tot.Currency) }
								<span class="text-light">
									switch  {
										case tot.Left().IsNegative() && inc:
											{ kit.T(ctx, "above plan") }
										case tot.Left().IsNegative():
											{ kit.T(ctx, "over") }
										case inc:
											{ kit.T(ctx, "to go") }
										default:
											{ kit.T(ctx, "left") }
									}
								</span>
							</span>
						}
					</div>
				</div>
				for _, it := range sec.Planned {
					<details open?={ d.Open == fmt.Sprintf("%d:%s", it.Row.Category.ID, it.Row.Currency) }>
						<summary>
							<span class="vstack gap-1 w-100">
								<span class="hstack justify-between">
									<span>
										if it.Parent != "" {
											<span class="text-light">{ it.Parent } › </span>
										}
										{ it.Row.Category.Name }
										if it.Row.Repeating {
											<span class="text-light" title={ kit.T(ctx, "Repeat every month") }>↻</span>
										}
									</span>
									<span class="align-right">{ kit.Money(ctx, it.Row.Spent, it.Row.Currency) } <span class="text-light">/ { kit.Money(ctx, it.Row.Plan, it.Row.Currency) }</span></span>
								</span>
								// clamp only the graphic; the label keeps the actual percentage
								<progress value={ min(max(it.Row.Percent(), 0), 100) } max="100" aria-label={ kit.T(ctx, "%d%% of plan", it.Row.Percent()) }>{ it.Row.Percent() }%</progress>
							</span>
						</summary>
						@planRowForm(it.Row, d, v.Errors)
					</details>
				}
				if len(sec.Planned) == 0 {
					<p class="text-light">{ kit.T(ctx, "No plans this month.") }</p>
				}
			</section>
		}
	}
}

templ newPlanPage(v kit.Page, d planFormData) {
	@kit.Layout(v, false, nil) {
		<h1>{ kit.T(ctx, "New plan") }</h1>
		<form id="form-plan" class="form-compact" method="post" action="/plans">
			@kit.FormError(v.Errors.Form("plan"), "")
			<input type="hidden" name="new" value="true"/>
			<fieldset class="row mb-4">
				@kit.Field("col-6", kit.T(ctx, "Month"), "", "", nil) {
					<select name="month">
						@kit.MonthOptions(d.Months, d.Month)
					</select>
				}
				{{ e := v.Errors.Get("category") }}
				@kit.Field("col-6", kit.T(ctx, "Category"), e, "category-error", nil) {
					<select name="category" { kit.Invalid(e, "category-error")... }>
						for _, k := range domain.Kinds() {
							<optgroup label={ kit.KindLabel(ctx, k) }>
								@kit.CategoryOptions(domain.ByKind(d.Categories, k), d.Posted.Category)
							</optgroup>
						}
					</select>
				}
				{{ e = v.Errors.Get("currency") }}
				@kit.Field("col-6", kit.T(ctx, "Currency"), e, "currency-error", nil) {
					@kit.CurrencySelect(d.Currencies, d.Posted.Currency, e)
				}
				{{ e = v.Errors.Get("amount") }}
				@kit.Field("col-6", kit.T(ctx, "Amount"), e, "amount-error", nil) {
					<input name="amount" inputmode="decimal" value={ d.Posted.Amount } { kit.Invalid(e, "amount-error")... }/>
				}
				@kit.Field("col-12", "", "", "", nil) {
					<input type="checkbox" name="repeating" value="true" checked?={ d.Posted.Repeating }/> { kit.T(ctx, "Repeat every month") }
				}
			</fieldset>
			<div class="hstack">
				<button type="submit">{ kit.T(ctx, "Create") }</button>
				@kit.LinkButton("/plans?month="+d.Month.String(), "secondary", kit.T(ctx, "Cancel"))
			</div>
		</form>
	}
}

// planRowForm sets the plan of row for the month of d, saving on change. A failed
// post re-renders the page with the errs of the form.
templ planRowForm(row domain.PlanRow, d plansData, errs *kit.FormErrors) {
	{{ e := errs.Get(planKey(row.Category.ID, row.Currency)) }}
	<div class="vstack gap-1 p-4">
		<form method="post" action="/plans" class="hstack gap-2" hx-post="/plans" hx-trigger="change" hx-target="main" hx-select="main" hx-swap="outerHTML">
			<input type="hidden" name="month" value={ d.Month.String() }/>
			<input type="hidden" name="category" value={ row.Category.ID }/>
			<input type="hidden" name="currency" value={ row.Currency }/>
			<input
				name="amount"
				class="small"
				inputmode="decimal"
				size="8"
				if e != "" {
					value={ d.Posted.Amount }
				} else {
					value={ kit.AmountInput(ctx, row.Plan.Fixed(row.Currency)) }
				}
				placeholder={ kit.T(ctx, "Amount") }
				title={ kit.T(ctx, "Clear the amount to remove it for this month.") }
				aria-label={ kit.T(ctx, "Plan for %s", row.Category.Name) }
				{ kit.Invalid(e, "")... }
			/>
			<label><input type="checkbox" role="switch" name="repeating" value="true" checked?={ row.Repeating }/> { kit.T(ctx, "Repeat every month") }</label>
			<a href={ fmt.Sprintf("/operations?category=%d&from=%s&to=%s", row.Category.ID, d.From, d.To) }>{ kit.T(ctx, "Operations") } →</a>
		</form>
		@kit.FieldError(e, "")
	</div>
}
