package plans

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/timex"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ plansPage(v kit.Page, d plansData) {
	@kit.Layout(v, false, nil) {
		<div class="hstack justify-between mb-4">
			<div class="hstack">
				@kit.NewButton("/plans/new?month="+d.Month.String(), kit.T(ctx, "Plan"))
				@fillButton(d.Month, false)
			</div>
			@kit.MonthNav("/plans", d.Month, d.Months, d.Prev, d.Next)
		</div>
		{{
			empty := true
			for _, sec := range d.Sections {
				empty = empty && len(sec.Planned) == 0
			}
		}}
		if empty {
			<p class="text-light">{ kit.T(ctx, "No plans this month.") }</p>
		} else {
			for _, sec := range d.Sections {
				{{ inc := sec.Kind == domain.KindIncome }}
				<section class="mb-6">
					<h2 class="kind">{ kit.KindLabel(ctx, sec.Kind) }</h2>
					for _, tot := range sec.Totals {
						<div class="card p-4 vstack gap-2 mb-2">
							<div class="hstack justify-between">
								<strong>{ kit.T(ctx, "Total") }</strong>
								<span class="text-light">{ kit.T(ctx, "%d%% of plan", tot.Percent()) }</span>
							</div>
							@planProgress(tot, inc, money.CurrencySymbol(tot.Currency))
						</div>
					}
					for _, it := range sec.Planned {
						<details open?={ d.Open == fmt.Sprintf("%d:%s", it.Row.Category.ID, it.Row.Currency) }>
							<summary>
								<span class="vstack gap-2 w-100">
									<span class="hstack gap-1">
										if it.Parent != "" {
											<span class="text-light">{ it.Parent } ›</span>
										}
										{ it.Row.Category.Name }
										if it.Row.Repeating {
											<svg width="12" height="12" class="text-light" role="img" aria-label={ kit.T(ctx, "Repeat every month") }><title>{ kit.T(ctx, "Repeat every month") }</title><use href="/static/img/icons.svg#refresh-cw"></use></svg>
										}
									</span>
									@planProgress(it.Row, inc, money.CurrencySymbol(it.Row.Currency))
								</span>
							</summary>
							@planRowForm(it.Row, d, v.Errors)
						</details>
					}
					if len(sec.Planned) == 0 {
						<p class="text-light">{ kit.T(ctx, "No plans this month.") }</p>
					}
				</section>
			}
		}
	}
}

// fillButton copies the repeating plans of the months before month into it, with a
// text label if labeled, else as an icon.
templ fillButton(month timex.Month, labeled bool) {
	<form method="post" action="/plans/fill">
		<input type="hidden" name="month" value={ month.String() }/>
		<button type="submit" class="outline" title={ kit.T(ctx, "Copy repeating plans from previous months") } aria-label={ kit.T(ctx, "Repeat plans") }>
			<svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#copy"></use></svg>
			if labeled {
				{ kit.T(ctx, "Repeat plans") }
			}
		</button>
	</form>
}

// planProgress is the meter of row against its plan, colored by how it goes for an
// expense, or for an income if inc, and the amounts under it, the plan followed by
// symbol, if any.
templ planProgress(row domain.PlanRow, inc bool, symbol string) {
	{{
		left := row.Left()
		pct := row.Percent()
	}}
	// clamp only the graphic; the label keeps the actual percentage. An expense turns
	// yellow near its plan and red over it, an income green once it reaches it. Over the
	// plan, the bar is as long as the amount, and a tick marks where the plan ends.
	if pct > 100 {
		<div class="over-plan" style={ fmt.Sprintf("--plan: %.2f%%", 10000/float64(pct)) }>
			if inc {
				<meter value="1" max="1" low="0.5" high="0.5" optimum="1" aria-label={ kit.T(ctx, "%d%% of plan", pct) }>{ pct }%</meter>
			} else {
				<meter value="1" max="1" low="0.5" high="0.5" optimum="0" aria-label={ kit.T(ctx, "%d%% of plan", pct) }>{ pct }%</meter>
			}
		</div>
	} else if inc {
		<meter value={ min(max(row.Percent(), 0), 100) } max="100" low="0" high="99" optimum="100" aria-label={ kit.T(ctx, "%d%% of plan", row.Percent()) }>{ row.Percent() }%</meter>
	} else {
		<meter value={ min(max(row.Percent(), 0), 101) } max="101" low="80" high="100" optimum="0" aria-label={ kit.T(ctx, "%d%% of plan", row.Percent()) }>{ row.Percent() }%</meter>
	}
	<small class="hstack justify-between">
		<span><span data-amount>{ kit.Money(ctx, row.Spent, row.Currency) }</span> <span class="text-light">{ kit.T(ctx, "of") } <span data-amount>{ kit.Money(ctx, row.Plan, row.Currency) } { symbol }</span></span></span>
		<span>
			<span data-amount>{ kit.Money(ctx, left.Abs(), row.Currency) }</span>
			<span class="text-light">
				switch  {
					case left.IsNegative() && inc:
						{ kit.T(ctx, "above plan") }
					case left.IsNegative():
						{ kit.T(ctx, "over") }
					case inc:
						{ kit.T(ctx, "to go") }
					default:
						{ kit.T(ctx, "left") }
				}
			</span>
		</span>
	</small>
}

templ newPlanPage(v kit.Page, d planFormData) {
	@kit.Layout(v, false, nil) {
		<h1>{ kit.T(ctx, "New plan") }</h1>
		<form id="form-plan" class="form-compact" method="post" action="/plans">
			@kit.FormError(v.Errors.Form("plan"), "")
			<input type="hidden" name="new" value="true"/>
			<fieldset class="row mb-4">
				@kit.Field("col-6", kit.T(ctx, "Month"), "", "", nil) {
					<select name="month">
						@kit.MonthOptions(d.Months, d.Month)
					</select>
				}
				{{ e := v.Errors.Get("category") }}
				@kit.Field("col-6", kit.T(ctx, "Category"), e, "category-error", nil) {
					{{
						var tree []domain.Category
						for _, k := range domain.Kinds() {
							tree = append(tree, domain.ByKind(d.Categories, k)...)
						}
					}}
					@kit.Select("category", kit.CategoryOptions(ctx, tree, []int64{d.Posted.Category}, false), strconv.FormatInt(d.Posted.Category, 10), kit.Invalid(e, "category-error"))
				}
				{{ e = v.Errors.Get("currency") }}
				@kit.Field("col-6", kit.T(ctx, "Currency"), e, "currency-error", nil) {
					@kit.CurrencySelect(d.Currencies, d.Posted.Currency, e)
				}
				{{ e = v.Errors.Get("amount") }}
				@kit.Field("col-6", kit.T(ctx, "Amount"), e, "amount-error", nil) {
					<input name="amount" inputmode="decimal" value={ d.Posted.Amount } { kit.Invalid(e, "amount-error")... }/>
				}
				@kit.Field("col-12", "", "", "", nil) {
					<input type="checkbox" name="repeating" value="true" checked?={ d.Posted.Repeating }/> { kit.T(ctx, "Repeat every month") }
				}
			</fieldset>
			<div class="hstack">
				<button type="submit">{ kit.T(ctx, "Create") }</button>
			</div>
		</form>
	}
}

// planRowForm sets the plan of row for the month of d, saving on change. A failed
// post re-renders the page with the errs of the form.
templ planRowForm(row domain.PlanRow, d plansData, errs *kit.FormErrors) {
	{{ e := errs.Get(planKey(row.Category.ID, row.Currency)) }}
	<form method="post" action="/plans" class="form-compact" hx-post="/plans" hx-trigger="change" hx-target="main" hx-select="main" hx-swap="outerHTML">
		<input type="hidden" name="month" value={ d.Month.String() }/>
		<input type="hidden" name="category" value={ row.Category.ID }/>
		<input type="hidden" name="currency" value={ row.Currency }/>
		<div class="hstack justify-between">
			<span class="hstack">
				@kit.Field("", "", e, "", nil) {
					<input
						name="amount"
						inputmode="decimal"
						size="8"
						if e != "" {
							value={ d.Posted.Amount }
						} else {
							value={ kit.AmountInput(ctx, row.Plan.Fixed(row.Currency)) }
						}
						placeholder={ kit.T(ctx, "Amount") }
						aria-label={ kit.T(ctx, "Plan for %s", row.Category.Name) }
						{ kit.Invalid(e, "")... }
					/>
				}
				<label title={ kit.T(ctx, "Repeat every month") }><input type="checkbox" role="switch" name="repeating" value="true" checked?={ row.Repeating } aria-label={ kit.T(ctx, "Repeat every month") }/> <svg width="14" height="14" aria-hidden="true"><use href="/static/img/icons.svg#refresh-cw"></use></svg></label>
			</span>
			<span class="hstack gap-1">
				<a class="button outline small" href={ fmt.Sprintf("/operations?cat=%d&from=%s&to=%s", row.Category.ID, d.From, d.To) } aria-label={ kit.T(ctx, "Operations") } title={ kit.T(ctx, "Operations") }><svg width="14" height="1lh" aria-hidden="true"><use href="/static/img/icons.svg#funnel"></use></svg></a>
				<button
					type="button"
					class="outline small"
					data-variant="danger"
					hx-delete={ "/plans?" + url.Values{"month": {d.Month.String()}, "category": {strconv.FormatInt(row.Category.ID, 10)}, "currency": {row.Currency}}.Encode() }
					hx-confirm={ kit.T(ctx, "Delete the plan for %s this month?", row.Category.Name) }
					hx-target="main"
					hx-select="main"
					hx-swap="outerHTML"
					aria-label={ kit.T(ctx, "Delete") }
					title={ kit.T(ctx, "Delete") }
				><svg width="14" height="1lh" aria-hidden="true"><use href="/static/img/icons.svg#trash"></use></svg></button>
			</span>
		</div>
		if row.Repeating {
			<small class="text-light">{ kit.T(ctx, "Repeats every month") }</small>
		}
	</form>
}
