package operations

import (
	"context"
	"fmt"
	"strconv"
	"strings"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/timex"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ listPage(v kit.Page, d opList) {
	@kit.Layout(v, len(d.Days) > 0, nil) {
		<div class="hstack justify-between mb-4">
			<div class="hstack">
				<a class="button op-new" href="/operations/new">+ { kit.T(ctx, "Operation") }</a>
				<ot-dropdown>
					<button type="button" class="outline" popovertarget="op-actions" aria-label={ kit.T(ctx, "More actions") }><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#ellipsis"></use></svg></button>
					<menu popover id="op-actions">
						if d.BankSync {
							<button type="submit" form="op-sync" id="op-sync-button" role="menuitem" class="ghost">
								{ kit.T(ctx, "Sync") }
								if !d.BankSyncAt.IsZero() {
									<small class="text-light">{ kit.Datetime(ctx, d.BankSyncAt, v.User) }</small>
								}
							</button>
						}
						@runRules(d)
						<a href="/rules" role="menuitem" class="button ghost">{ kit.T(ctx, "Rules") }</a>
					</menu>
				</ot-dropdown>
			</div>
			<div class="hstack">
				// the order belongs to the filter form, so every way of getting the list keeps it
				<ot-dropdown>
					<menu class="buttons">
						<li>
							@kit.SearchButton()
						</li>
						<li>
							<button
								type="button"
								popovertarget="op-sort"
								class="outline"
								aria-label={ kit.T(ctx, "Sort") }
							><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#arrow-down-up"></use></svg></button>
						</li>
						<li>
							@kit.FilterButton(d.FilterCount)
						</li>
					</menu>
					<menu popover id="op-sort">
						for _, s := range domain.OpSorts() {
							<label role="menuitem">
								<input
									type="radio"
									name="sort"
									form="filter-form"
									value={ string(s) }
									checked?={ s == d.Filter.Sort || s == domain.SortNewestFirst && d.Filter.Sort == "" }
									{ kit.ListGet("/operations", "#op-run")... }
								/>
								{ sortLabel(ctx, s) }
							</label>
						}
					</menu>
				</ot-dropdown>
				{{
					reset := ""
					if d.Filtered {
						reset = d.ResetURL
					}
				}}
				@kit.ResetButton(reset)
			</div>
		</div>
		@kit.SearchDialog("/operations", d.Filter.Query, kit.T(ctx, "Payee, amount, account, category, tag"), "#op-run")
		// outside the toolbar: an hstack zeroes the margins that center a dialog
		if d.BankSync {
			<form id="op-sync" method="post" action="/operations/sync" hx-disable="#op-sync-button"></form>
		}
		@kit.FilterDialog("/operations") {
			@filterFields(d)
		}
		<div id="list-results">
			@listResults(d)
		</div>
		// on phones it replaces the button of the toolbar, under the thumb
		<a class="button outline fab" href="/operations/new" aria-label={ kit.T(ctx, "Operation") }>+</a>
	}
}

// runRules is the menu item running rules on the operations of d.
templ runRules(d opList) {
	<form
		id="op-run"
		method="post"
		action={ d.RunURL }
		if d.Filtered {
			hx-confirm={ kit.T(ctx, "Run rules on the filtered operations?") }
		} else {
			hx-confirm={ kit.T(ctx, "Run rules on all operations?") }
		}
	>
		<button type="submit" role="menuitem" class="ghost">{ kit.T(ctx, "Run rules") }</button>
	</form>
}

// sortLabel is the name of the order s in the sort menu.
func sortLabel(ctx context.Context, s domain.OpSort) string {
	switch s {
	case domain.SortOldestFirst:
		return kit.T(ctx, "Oldest first")
	case domain.SortLargestFirst:
		return kit.T(ctx, "Largest first")
	case domain.SortSmallestFirst:
		return kit.T(ctx, "Smallest first")
	case domain.SortNewestFirst:
	}
	return kit.T(ctx, "Newest first")
}

// listResults is the part of the operations page the search and the sort swap in.
templ listResults(d opList) {
	if len(d.Mismatched) > 0 {
		<div class="vstack gap-2 mb-4">
			for _, t := range d.Mismatched {
				{{ a := d.AccByID[t.AccountID] }}
				<div role="alert" data-variant="warning">
					<span class="hstack gap-1">
						{ kit.T(ctx, "Balance differs from the bank:") }
						@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
						<a href={ fmt.Sprintf("/accounts/%d", a.ID) }><strong>{ a.Name }</strong></a>
						@kit.BankBadge(t, a)
					</span>
				</div>
			}
		</div>
	}
	if d.Changed >= 0 {
		<p role="status" class="badge mb-4" data-variant="success">{ kit.T(ctx, "Rules changed %d operations.", d.Changed) }</p>
	}
	if len(d.Days) > 0 {
		<ul class="unstyled vstack gap-1">
			@kit.OpRows(d.Days, d.CatNames, d.AccByID, d.MoreURL)
		</ul>
	} else if d.Filtered {
		<p class="text-light">{ kit.T(ctx, "Nothing found.") }</p>
	} else {
		@kit.NoOperations()
	}
}

// filterFields are the fields of the filter dialog of the operations of d, but the query
// and the order.
templ filterFields(d opList) {
	@kit.Field("col-6", kit.T(ctx, "Account"), "", "", nil) {
		<select name="account">
			<option value="">{ kit.T(ctx, "All") }</option>
			for _, a := range d.Accounts {
				<option value={ a.ID } selected?={ a.ID == d.Filter.AccountID }>{ a.Name }</option>
			}
		</select>
	}
	@kit.Field("col-6", kit.T(ctx, "Type"), "", "", nil) {
		<select name="type" data-category-type>
			<option value="">{ kit.T(ctx, "All") }</option>
			for _, typ := range domain.OpTypes() {
				<option value={ string(typ) } selected?={ typ == d.Filter.Type }>{ kit.T(ctx, string(typ)) }</option>
			}
		</select>
	}
	// a root category also matches its nested ones
	// not a kit.Field: the checkboxes in a label would lay it out as one of theirs
	<div data-field class="col-12" data-category-field>
		<label for="filter-category">{ kit.T(ctx, "Categories") }</label>
		{{
			selected := d.Filter.CategoryIDs
			if d.Filter.Uncategorized {
				selected = append([]int64{kit.NoCategory}, selected...)
			}
		}}
		@kit.CategoryMultiSelect("cat", d.Categories, selected, []kit.CategoryChoice{
			{Value: strconv.FormatInt(kit.NoCategory, 10), Label: kit.T(ctx, "No category")},
		}, kit.T(ctx, "All"), templ.Attributes{"id": "filter-category"})
	</div>
	<div data-field class="col-12">
		<label for="filter-from">{ kit.T(ctx, "Date") }</label>
		<fieldset class="group">
			<input type="date" id="filter-from" name="from" value={ timex.FormatDate(d.Filter.DateFrom) } aria-label={ kit.T(ctx, "From") }/>
			<label for="filter-to" aria-hidden="true">—</label>
			<input type="date" id="filter-to" name="to" value={ timex.FormatDate(d.Filter.DateTo) } aria-label={ kit.T(ctx, "To") }/>
		</fieldset>
	</div>
	<div data-field class="col-12">
		<label for="filter-min">{ kit.T(ctx, "Amount") }</label>
		<fieldset class="group">
			<input
				id="filter-min"
				name="min"
				inputmode="decimal"
				if d.Filter.AmountMin.Valid {
					value={ kit.AmountInput(ctx, d.Filter.AmountMin.Amount.String()) }
				} else {
					value=""
				}
				placeholder={ kit.T(ctx, "min") }
				aria-label={ kit.T(ctx, "Amount from") }
			/>
			<label for="filter-max" aria-hidden="true">—</label>
			<input
				id="filter-max"
				name="max"
				inputmode="decimal"
				if d.Filter.AmountMax.Valid {
					value={ kit.AmountInput(ctx, d.Filter.AmountMax.Amount.String()) }
				} else {
					value=""
				}
				placeholder={ kit.T(ctx, "max") }
				aria-label={ kit.T(ctx, "Amount to") }
			/>
		</fieldset>
	</div>
	if len(d.Tags) > 0 {
		@tagsField("filter-tags", "filter-tag-list", strings.Join(d.Filter.Tags, ", "), kit.T(ctx, "All"), d.Tags, "", "col-12", true)
	}
}
