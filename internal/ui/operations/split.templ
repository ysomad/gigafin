package operations

import (
	"fmt"
	"strconv"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

// splitPage is the split page of an operation: its form in the dialog of the layout,
// open, as it is opened from the edit of the operation.
templ splitPage(v kit.Page, d opSplit) {
	{{ v.Dialog = splitForms(v, d) }}
	@kit.Layout(v, false, nil)
}

// splitDialog is the split form of an operation swapped into the dialog of the layout,
// and its toasts.
templ splitDialog(v kit.Page, d opSplit) {
	@splitForms(v, d)
	@kit.Toasts(v, true, nil)
}

// splitForms are the header, operation and split form of d in the dialog of the layout,
// posted by htmx into it, as opForms. Its back button returns to the edit.
templ splitForms(v kit.Page, d opSplit) {
	@kit.DialogHeader("op-dialog", kit.T(ctx, "Split"), fmt.Sprintf("/operations/%d/edit", d.Op.ID))
	<form
		id="form-split"
		method="post"
		action={ fmt.Sprintf("/operations/%d/split", d.Op.ID) }
		hx-post={ fmt.Sprintf("/operations/%d/split", d.Op.ID) }
		hx-target="#op-dialog"
		hx-swap="innerHTML"
		hx-disable="findAll button"
		data-split-total={ d.Amount }
	>
		if d.Back != "" {
			<input type="hidden" name="back" value={ d.Back }/>
		}
		// Oat lays out a dialog as a header, a body scrolling between, and a footer
		<div class="form-compact">
			@splitOp(d)
			@splitFields(v, d)
		</div>
		<footer>
			<div class="hstack justify-end w-100">
				<button type="submit">{ kit.T(ctx, "Split") }</button>
			</div>
		</footer>
	</form>
}

// splitOp is the card of the operation of d being split.
templ splitOp(d opSplit) {
	<div class="card compact hstack justify-between mb-4">
		<div>
			<div>{ kit.OpCategory(ctx, d.Op, d.CatNames) }</div>
			<small class="flex flex-col text-light">
				<span>
					{ kit.DayTitle(ctx, d.Op.Date) }
					if d.Op.Time != "" {
						{ d.Op.Time }
					}
				</span>
				<span class="hstack gap-1">
					<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Account") }><title>{ kit.T(ctx, "Account") }</title><use href="/static/img/icons.svg#wallet"></use></svg>
					{ kit.OpAccounts(d.Op, d.AccByID) }
				</span>
				if d.Op.Payee != "" {
					<span class="hstack gap-1">
						<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Payee") }><title>{ kit.T(ctx, "Payee") }</title><use href="/static/img/icons.svg#store"></use></svg>
						{ d.Op.Payee }
					</span>
				}
				if d.Op.Note != "" {
					<span class="hstack gap-1">
						<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Note") }><title>{ kit.T(ctx, "Note") }</title><use href="/static/img/icons.svg#message-square"></use></svg>
						{ d.Op.Note }
					</span>
				}
			</small>
		</div>
		<div class="align-right"><span data-amount>{ kit.OpAmount(ctx, d.Op) } <span class="text-light">{ money.CurrencySymbol(d.Op.Currency) }</span></span></div>
	</div>
}

// splitFields are the message and the parts of the split form of d.
templ splitFields(v kit.Page, d opSplit) {
	@kit.FormError(v.Errors.Form("split"), "")
	<p class="text-light">
		{ kit.T(ctx, "Divide the saved amount between categories. Each part becomes an operation of its own.") }
		if d.Op.IsSplit() {
			{ kit.T(ctx, "Part of a split. Splitting it again adds parts to the same split.") }
		}
	</p>
	<div id="splits" class="vstack gap-2">
		for i, p := range d.Parts {
			@splitRow(d.Categories, p, i == 0, i > 1, i, v.Errors)
		}
	</div>
	<button type="button" class="outline small" hx-get={ "/operations/split?type=" + string(d.Op.Type) } hx-target="#splits" hx-swap="beforeend" data-variant="secondary">+ { kit.T(ctx, "Add part") }</button>
}

// splitRow is a part of the split form. The first part is the operation itself: its
// amount is what the other parts leave of the saved total, kept by app.js. Only a
// removable part, one past the first two a split needs, can be removed. errs and index
// are set on the rows of a re-rendered form, not on added ones.
templ splitRow(categories []domain.Category, s splitPart, first, removable bool, index int, errs *kit.FormErrors) {
	{{
		catErr := errs.Get(fmt.Sprintf("split_category[%d]", index))
		amountErr := errs.Get(fmt.Sprintf("split_amount[%d]", index))
		noteErr := errs.Get(fmt.Sprintf("split_note[%d]", index))
	}}
	// a card of its own, so the parts stand apart on a phone, where their fields stack
	<div class="split card p-4">
		<div class="row">
			@kit.Field("col-5", kit.T(ctx, "Category"), catErr, "", nil) {
				@kit.Select("split_category", kit.CategoryOptions(ctx, categories, []int64{s.CategoryID}, false), strconv.FormatInt(s.CategoryID, 10), nil)
			}
			@kit.Field("col-3", kit.T(ctx, "Amount"), amountErr, "", nil) {
				<input
					name="split_amount"
					inputmode="decimal"
					autocomplete="off"
					value={ kit.AmountInput(ctx, s.Amount) }
					if first {
						readonly
						aria-disabled="true"
						tabindex="-1"
					}
				/>
			}
			@kit.Field("col-3", kit.T(ctx, "Note"), noteErr, "", nil) {
				<input name="split_note" value={ s.Note } autocomplete="off"/>
			}
			if removable {
				@kit.RemoveColumn(kit.T(ctx, "Remove part"), templ.Attributes{"data-split-remove": true})
			}
		</div>
	</div>
}
