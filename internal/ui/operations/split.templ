package operations

import (
	"fmt"
	"strconv"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ splitPage(v kit.Page, d opSplit) {
	@kit.Layout(v, false, nil) {
		<h1>{ kit.T(ctx, "Split") }</h1>
		<div class="card compact hstack justify-between mb-4">
			<div>
				<div>{ kit.OpCategory(ctx, d.Op, d.CatNames) }</div>
				<small class="flex flex-col text-light">
					<span>
						{ kit.DayTitle(ctx, d.Op.Date) }
						if d.Op.Time != "" {
							{ d.Op.Time }
						}
					</span>
					<span class="hstack gap-1">
						<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Account") }><title>{ kit.T(ctx, "Account") }</title><use href="/static/img/icons.svg#wallet"></use></svg>
						{ kit.OpAccounts(d.Op, d.AccByID) }
					</span>
					if d.Op.Payee != "" {
						<span class="hstack gap-1">
							<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Payee") }><title>{ kit.T(ctx, "Payee") }</title><use href="/static/img/icons.svg#store"></use></svg>
							{ d.Op.Payee }
						</span>
					}
					if d.Op.Note != "" {
						<span class="hstack gap-1">
							<svg width="12" height="12" role="img" aria-label={ kit.T(ctx, "Note") }><title>{ kit.T(ctx, "Note") }</title><use href="/static/img/icons.svg#message-square"></use></svg>
							{ d.Op.Note }
						</span>
					}
				</small>
			</div>
			<div class="align-right">{ kit.OpAmount(ctx, d.Op) } <span class="text-light">{ money.CurrencySymbol(d.Op.Currency) }</span></div>
		</div>
		<form id="form-split" class="form-compact" method="post" action={ fmt.Sprintf("/operations/%d/split", d.Op.ID) } data-split-total={ d.Amount }>
			@kit.FormError(v.Errors.Form("split"), "")
			<p class="text-light">
				{ kit.T(ctx, "Divide the saved amount between categories. Each part becomes an operation of its own.") }
				if d.Op.OriginID != 0 {
					{ kit.T(ctx, "Part of a split. Splitting it again adds parts to the same split.") }
				}
			</p>
			<article class="card mb-4">
				<div id="splits">
					for i, p := range d.Parts {
						@splitRow(d.Categories, p, i == 0, i, v.Errors)
					}
				</div>
				<button type="button" class="outline small" hx-get={ "/operations/split?type=" + string(d.Op.Type) } hx-target="#splits" hx-swap="beforeend" data-variant="secondary">+ { kit.T(ctx, "Add part") }</button>
			</article>
			<div class="hstack justify-end">
				<button type="submit">{ kit.T(ctx, "Split") }</button>
			</div>
		</form>
	}
}

// splitRow is a part of the split form. The first part is the operation itself: it
// can't be removed and its amount is what the other parts leave of the saved total,
// kept by app.js. errs and index are set on the rows of a re-rendered form, not on
// added ones.
templ splitRow(categories []domain.Category, s splitPart, first bool, index int, errs *kit.FormErrors) {
	{{
		catErr := errs.Get(fmt.Sprintf("split_category[%d]", index))
		amountErr := errs.Get(fmt.Sprintf("split_amount[%d]", index))
		noteErr := errs.Get(fmt.Sprintf("split_note[%d]", index))
	}}
	<div class="split row mb-4">
		@kit.Field("col-5", kit.T(ctx, "Category"), catErr, "", nil) {
			@kit.Select("split_category", kit.CategoryOptions(ctx, categories, []int64{s.CategoryID}, false), strconv.FormatInt(s.CategoryID, 10), nil)
		}
		@kit.Field("col-3", kit.T(ctx, "Amount"), amountErr, "", nil) {
			<input
				name="split_amount"
				inputmode="decimal"
				autocomplete="off"
				value={ kit.AmountInput(ctx, s.Amount) }
				if first {
					readonly
					aria-disabled="true"
					tabindex="-1"
				}
			/>
		}
		@kit.Field("col-3", kit.T(ctx, "Note"), noteErr, "", nil) {
			<input name="split_note" value={ s.Note } autocomplete="off"/>
		}
		if !first {
			@kit.RemoveColumn(kit.T(ctx, "Remove part"), templ.Attributes{"data-split-remove": true})
		}
	</div>
}
