package components

import (
	"cmp"
	"fmt"

	"github.com/ysomad/gigafin/internal/ui/view"
)

// AccessCard lists the sessions and API keys of the user and creates a key: the new
// key is shown once.
templ AccessCard(v view.Page, d view.Settings) {
	<article id="settings-access" class="card mb-4 form-compact">
		<h3>{ view.T(ctx, "Security & access") }</h3>
		if d.NewToken != "" {
			<div>
				<p class="text-light">{ view.T(ctx, "Copy this key and store it somewhere safe, like a password manager. It won't be shown again, and anyone who has it can access your data.") }</p>
				<fieldset class="group">
					<input readonly value={ d.NewToken } aria-label={ view.T(ctx, "API key") } autocomplete="off" spellcheck="false" autofocus/>
					<button type="button" class="icon outline" data-copy={ d.NewToken } aria-label={ view.T(ctx, "Copy key") }>
						<svg data-icon="copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
						<svg data-icon="check" hidden width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
					</button>
				</fieldset>
			</div>
		}
		<div class="table">
			<table>
				<thead><tr><th>{ view.T(ctx, "Type") }</th><th>{ view.T(ctx, "Name") }</th><th>{ view.T(ctx, "Scope") }</th><th>{ view.T(ctx, "Last used") }</th><th>{ view.T(ctx, "Expires") }</th><th></th></tr></thead>
				<tbody>
					for _, s := range d.Sessions {
						<tr>
							<td>{ view.T(ctx, "Session") }</td>
							<td>{ s.UserAgent }</td>
							<td>{ view.T(ctx, "full") }</td>
							<td>{ view.Datetime(ctx, s.LastUsedAt, v.User) }</td>
							<td>{ view.Datetime(ctx, s.ExpiresAt, v.User) }</td>
							<td>
								if s.Current {
									<span class="badge" data-variant="success">{ view.T(ctx, "this browser") }</span>
								} else {
									{{ action := fmt.Sprintf("/settings/sessions/%d/revoke", s.ID) }}
									<form method="post" action={ templ.SafeURL(action) } { view.HXCard(action, "settings-access", "#toasts")... } hx-confirm={ view.T(ctx, "Sign out this session?") }>
										<button type="submit" class="outline small" data-variant="secondary">{ view.T(ctx, "Revoke") }</button>
									</form>
								}
							</td>
						</tr>
					}
					for _, k := range d.Keys {
						<tr>
							<td>{ view.T(ctx, "API key") }</td>
							<td>{ k.Name } <code>gf_{ k.Prefix }_…</code></td>
							<td>{ view.T(ctx, string(k.Scope)) }</td>
							<td>
								if k.LastUsedAt.IsZero() {
									{ view.T(ctx, "never") }
								} else {
									{ view.Datetime(ctx, k.LastUsedAt, v.User) }
								}
							</td>
							<td>
								if k.ExpiresAt.IsZero() {
									{ view.T(ctx, "never") }
								} else {
									{ view.Datetime(ctx, k.ExpiresAt, v.User) }
								}
							</td>
							<td>
								if k.Expired {
									<span class="badge" data-variant="secondary">{ view.T(ctx, "expired") }</span>
								} else {
									{{ action := fmt.Sprintf("/settings/api-keys/%d/revoke", k.ID) }}
									<form method="post" action={ templ.SafeURL(action) } { view.HXCard(action, "settings-access", "#toasts")... } hx-confirm={ view.T(ctx, "Revoke %s?", k.Name) }>
										<button type="submit" class="outline small" data-variant="secondary">{ view.T(ctx, "Revoke") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<form id="form-apikey" method="post" action="/settings/api-keys" class="row" { view.HXCard("/settings/api-keys", "settings-access", "#toasts")... }>
			@FormError(v.Errors.Form("apikey"), "col-12")
			{{ e := v.Errors.Get("apikey.name") }}
			@Field("col-3", view.T(ctx, "API key name"), e, "apikey-name-error", nil) {
				<input
					name="name"
					placeholder={ view.T(ctx, "e.g. shortcuts") }
					if len(d.Posted) > 0 {
						value={ d.Posted.Get("name") }
					}
					{ view.Invalid(e, "apikey-name-error")... }
				/>
			}
			{{ e = v.Errors.Get("apikey.scope") }}
			@Field("col-2", view.T(ctx, "Scope"), e, "apikey-scope-error", nil) {
				{{ scope := cmp.Or(d.Posted.Get("scope"), "read") }}
				<select name="scope" { view.Invalid(e, "apikey-scope-error")... }>
					<option value="read" selected?={ scope == "read" }>{ view.T(ctx, "read") }</option>
					<option value="write" selected?={ scope == "write" }>{ view.T(ctx, "write") }</option>
				</select>
			}
			{{ e = v.Errors.Get("apikey.expires") }}
			@Field("col-2", view.T(ctx, "Expiration"), e, "apikey-expiration-error", nil) {
				{{ expires := cmp.Or(d.Posted.Get("expires"), "30") }}
				<select name="expires" { view.Invalid(e, "apikey-expiration-error")... }>
					<option value="7" selected?={ expires == "7" }>{ view.T(ctx, "7 days") }</option>
					<option value="30" selected?={ expires == "30" }>{ view.T(ctx, "30 days") }</option>
					<option value="90" selected?={ expires == "90" }>{ view.T(ctx, "90 days") }</option>
					<option value="365" selected?={ expires == "365" }>{ view.T(ctx, "1 year") }</option>
					<option value="never" selected?={ expires == "never" }>{ view.T(ctx, "No expiration") }</option>
				</select>
			}
			{{ e = v.Errors.Get("apikey.password") }}
			@Field("col-3", view.T(ctx, "Current password"), e, "apikey-password-error", nil) {
				<input type="password" name="password" autocomplete="current-password" { view.Invalid(e, "apikey-password-error")... }/>
			}
			@SubmitColumn("col-2", "", view.T(ctx, "Create key"))
		</form>
	</article>
}
