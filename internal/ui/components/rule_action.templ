package components

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// RuleAction is an action row of the rule form: r, with the categories for the
// category select. errs and index are set on the rows of a re-rendered form, not on
// added ones.
templ RuleAction(r view.ActionRow, categories []domain.Category, index int, errs *view.FormErrors) {
	{{
		typeErr := errs.Get(fmt.Sprintf("act_type[%d]", index))
		valueErr := errs.Get(fmt.Sprintf("act_value[%d]", index))
	}}
	<div class="act row mb-4">
		@Field("col-4", view.T(ctx, "Action"), typeErr, "", nil) {
			<select name="act_type" hx-get="/rules/action" hx-include="closest .act" hx-target="closest .act" hx-swap="outerHTML">
				for _, typ := range domain.ActionTypes() {
					<option value={ string(typ) } selected?={ typ == r.Type }>{ view.RuleActionLabel(ctx, typ) }</option>
				}
			</select>
		}
		@Field("col-4", view.T(ctx, "Value"), valueErr, "", nil) {
			if r.Type == domain.ActionSetCategory {
				<select name="act_value">
					<option value="">—</option>
					@CategoryOptions(categories, r.ID)
				</select>
			} else {
				<input name="act_value" value={ r.Value } autocomplete="off"/>
			}
		}
		<div class="col-12 hstack"><button type="button" class="outline small" hx-get="/noop" hx-target="closest .act" hx-swap="delete" aria-label={ view.T(ctx, "Remove action") } data-variant="secondary">✕</button></div>
	</div>
}
