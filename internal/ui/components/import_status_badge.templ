package components

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// ImportStatusBadge is the status of an import.
templ ImportStatusBadge(status domain.ImportStatus) {
	<span
		class="badge"
		if status == domain.ImportCommitted {
			data-variant="success"
		}
		else
		if status != domain.ImportStaged {
			data-variant="secondary"
		}
	>{ view.T(ctx, string(status)) }</span>
}
