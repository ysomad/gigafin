package components

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// PlanRowForm sets the plan of row for the month of d, saving on change. A failed
// post re-renders the page with the errs of the form.
templ PlanRowForm(row domain.PlanRow, d view.Plans, errs *view.FormErrors) {
	{{ e := errs.Get(view.PlanKey(row.Category.ID, row.Currency)) }}
	<div class="vstack gap-1 p-4">
		<form method="post" action="/plans" class="hstack gap-2" hx-post="/plans" hx-trigger="change" hx-target="main" hx-select="main" hx-swap="outerHTML">
			<input type="hidden" name="month" value={ d.Month.String() }/>
			<input type="hidden" name="category" value={ row.Category.ID }/>
			<input type="hidden" name="currency" value={ row.Currency }/>
			<input
				name="amount"
				class="small"
				inputmode="decimal"
				size="8"
				if e != "" {
					value={ d.Posted.Amount }
				} else {
					value={ view.AmountInput(ctx, row.Plan.Fixed(row.Currency)) }
				}
				placeholder={ view.T(ctx, "Amount") }
				title={ view.T(ctx, "Clear the amount to remove it for this month.") }
				aria-label={ view.T(ctx, "Plan for %s", row.Category.Name) }
				{ view.Invalid(e, "")... }
			/>
			<label><input type="checkbox" role="switch" name="repeating" value="true" checked?={ row.Repeating }/> { view.T(ctx, "Repeat every month") }</label>
			<a href={ templ.SafeURL(fmt.Sprintf("/operations?category=%d&from=%s&to=%s", row.Category.ID, d.From, d.To)) }>{ view.T(ctx, "Operations") } →</a>
		</form>
		@FieldError(e, "")
	</div>
}
