package components

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// SplitRow is a part of the split form. The first part is the operation itself: it
// can't be removed and its amount is what the other parts leave of the saved total,
// kept by app.js. errs and index are set on the rows of a re-rendered form, not on
// added ones.
templ SplitRow(categories []domain.Category, s view.SplitForm, first bool, index int, errs *view.FormErrors) {
	{{
		catErr := errs.Get(fmt.Sprintf("split_category[%d]", index))
		amountErr := errs.Get(fmt.Sprintf("split_amount[%d]", index))
		noteErr := errs.Get(fmt.Sprintf("split_note[%d]", index))
	}}
	<div class="split row">
		<div class="hstack justify-between col-12">
			<small class="text-light">
				if first {
					{ view.T(ctx, "This operation") }
				} else {
					{ view.T(ctx, "New part") }
				}
			</small>
			if !first {
				<button type="button" class="outline small" data-split-remove data-variant="danger" aria-label={ view.T(ctx, "Remove part") } title={ view.T(ctx, "Remove part") }>✕</button>
			}
		</div>
		@Field("col-6", view.T(ctx, "Category"), catErr, "", nil) {
			<select name="split_category" { view.Invalid(catErr, "")... }>
				<option value="">—</option>
				@CategoryOptions(categories, s.CategoryID)
			</select>
		}
		@Field("col-6", view.T(ctx, "Amount"), amountErr, "", nil) {
			<input
				name="split_amount"
				inputmode="decimal"
				autocomplete="off"
				value={ view.AmountInput(ctx, s.Amount) }
				if first {
					readonly
					aria-disabled="true"
					tabindex="-1"
				}
				{ view.Invalid(amountErr, "")... }
			/>
		}
		@Field("col-12", "", noteErr, "", nil) {
			<input name="split_note" value={ s.Note } placeholder={ view.T(ctx, "Note") } aria-label={ view.T(ctx, "Note") } { view.Invalid(noteErr, "")... }/>
		}
	</div>
}
