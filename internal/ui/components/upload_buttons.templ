package components

import "github.com/ysomad/gigafin/internal/ui/view"

// UploadButtons cancel, go back to the source step or upload.
templ UploadButtons() {
	<div class="hstack mb-4">
		@LinkButton("/imports", "secondary", view.T(ctx, "Cancel"))
		@LinkButton("/imports/new", "secondary", view.T(ctx, "Back"))
		<button type="submit" data-spinner>{ view.T(ctx, "Upload") }</button>
	</div>
}
