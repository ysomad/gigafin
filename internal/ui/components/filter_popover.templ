package components

import (
	"strings"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/timex"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// FilterPopover is the dialog of the filters of the operations of d, but the query.
templ FilterPopover(d view.Ops) {
	<article class="card p-4 form-compact" popover id="filter-popover">
		<div class="row">
			@Field("col-6", view.T(ctx, "Account"), "", "", nil) {
				<select name="account">
					<option value="">{ view.T(ctx, "All") }</option>
					for _, a := range d.Accounts {
						<option value={ a.ID } selected?={ a.ID == d.Filter.AccountID }>{ a.Name }</option>
					}
				</select>
			}
			@Field("col-6", view.T(ctx, "Type"), "", "", nil) {
				<select name="type" data-category-type>
					<option value="">{ view.T(ctx, "All") }</option>
					for _, typ := range domain.OpTypes() {
						<option value={ string(typ) } selected?={ typ == d.Filter.Type }>{ view.T(ctx, string(typ)) }</option>
					}
				</select>
			}
			@Field("col-12", view.T(ctx, "Category"), "", "", templ.Attributes{"data-category-field": true}) {
				<select name="category">
					<option value="">{ view.T(ctx, "All") }</option>
					for _, parent := range d.Categories {
						<option value={ parent.ID } data-kind={ string(parent.Kind) } selected?={ parent.ID == d.Filter.CategoryID }>{ parent.Name }</option>
						for _, c := range parent.Children {
							<option value={ c.ID } data-kind={ string(parent.Kind) } selected?={ c.ID == d.Filter.CategoryID }>{ parent.Name } / { c.Name }</option>
						}
					}
				</select>
			}
			<div data-field class="col-12">
				<label for="filter-from">{ view.T(ctx, "Date") }</label>
				<fieldset class="group">
					<input type="date" id="filter-from" name="from" value={ timex.FormatDate(d.Filter.DateFrom) } aria-label={ view.T(ctx, "From") }/>
					<label for="filter-to" aria-hidden="true">—</label>
					<input type="date" id="filter-to" name="to" value={ timex.FormatDate(d.Filter.DateTo) } aria-label={ view.T(ctx, "To") }/>
				</fieldset>
			</div>
			<div data-field class="col-12">
				<label for="filter-min">{ view.T(ctx, "Amount") }</label>
				<fieldset class="group">
					<input
						id="filter-min"
						name="min"
						inputmode="decimal"
						if d.Filter.AmountMin.Valid {
							value={ view.AmountInput(ctx, d.Filter.AmountMin.Amount.String()) }
						} else {
							value=""
						}
						placeholder={ view.T(ctx, "min") }
						aria-label={ view.T(ctx, "Amount from") }
					/>
					<label for="filter-max" aria-hidden="true">—</label>
					<input
						id="filter-max"
						name="max"
						inputmode="decimal"
						if d.Filter.AmountMax.Valid {
							value={ view.AmountInput(ctx, d.Filter.AmountMax.Amount.String()) }
						} else {
							value=""
						}
						placeholder={ view.T(ctx, "max") }
						aria-label={ view.T(ctx, "Amount to") }
					/>
				</fieldset>
			</div>
			if len(d.Tags) > 0 {
				@TagsField("filter-tags", "filter-tag-list", strings.Join(d.Filter.Tags, ", "), view.T(ctx, "All"), d.Tags, "", "col-12")
			}
		</div>
		<footer class="hstack justify-end mt-4">
			<button type="button" class="outline" popovertarget="filter-popover" popovertargetaction="hide">{ view.T(ctx, "Close") }</button>
			<button type="submit">{ view.T(ctx, "Apply") }</button>
		</footer>
	</article>
}
