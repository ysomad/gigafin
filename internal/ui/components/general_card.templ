package components

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// GeneralCard is the settings form; the values of a failed post fill its inputs again.
templ GeneralCard(v view.Page, d view.Settings) {
	{{
		s := d.Settings
		posted := v.Form == "settings"
		tz, lng, src, cur := v.User.Timezone, s.Language, string(s.RateSource), s.PrimaryCurrency
		minor, auto := s.ShowMinorUnits, s.AutoCategoryRules
		if posted {
			tz, lng = d.Posted.Get("timezone"), d.Posted.Get("language")
			src, cur = d.Posted.Get("rate_source"), d.Posted.Get("primary_currency")
			minor, auto = d.Posted.Get("show_minor_units") == "on", d.Posted.Get("auto_category_rules") == "on"
		}
	}}
	<article id="settings-general" class="card mb-4 form-compact">
		<h3>{ view.T(ctx, "General") }</h3>
		<form id="form-settings" method="post" action="/settings" class="vstack" { view.HXCard("/settings", "settings-general", "#toasts,#settings-rates,#settings-access")... } hx-trigger="change">
			@FormError(v.Errors.Form("settings"), "")
			<div class="row">
				{{ e := v.Errors.Get("settings.timezone") }}
				@Field("col-3", view.T(ctx, "Time zone"), e, "timezone-error", nil) {
					<input name="timezone" value={ tz } placeholder="Europe/Moscow" { view.Invalid(e, "timezone-error")... }/>
				}
				{{ e = v.Errors.Get("settings.language") }}
				@Field("col-3", view.T(ctx, "Language"), e, "language-error", nil) {
					<select name="language" { view.Invalid(e, "language-error")... }>
						<option value="" selected?={ lng == "" }>{ view.T(ctx, "Default") }</option>
						for _, l := range d.Languages {
							<option value={ l.Code } selected?={ lng == l.Code }>{ l.Name }</option>
						}
					</select>
				}
				{{ e = v.Errors.Get("settings.rate_source") }}
				@Field("col-3", view.T(ctx, "Exchange rates"), e, "rate-source-error", nil) {
					<select name="rate_source" { view.Invalid(e, "rate-source-error")... }>
						for _, rs := range d.RateSources {
							<option value={ string(rs) } selected?={ string(rs) == src }>
								switch rs {
									case "":
										{ view.T(ctx, "Off") }
									case domain.RateSourceCBR:
										{ view.T(ctx, "Central Bank of Russia") }
									default:
										{ string(rs) }
								}
							</option>
						}
					</select>
				}
				{{ e = v.Errors.Get("settings.primary_currency") }}
				@Field("col-3", view.T(ctx, "Primary currency"), e, "primary-currency-error", nil) {
					<select name="primary_currency" { view.Invalid(e, "primary-currency-error")... }>
						<option value=""></option>
						for _, c := range d.Currencies {
							<option value={ c } selected?={ c == cur }>{ c }</option>
						}
					</select>
				}
			</div>
			<div class="row">
				<label data-field class="col-3"><input type="checkbox" role="switch" name="show_minor_units" checked?={ minor }/> { view.T(ctx, "Show minor units") }</label>
				<label data-field class="col-6" title={ view.T(ctx, "When 3 of the 5 latest operations of a payee have one category, a rule sets it for the payee.") }><input type="checkbox" role="switch" name="auto_category_rules" checked?={ auto }/> { view.T(ctx, "Learn from my categories") }</label>
			</div>
		</form>
	</article>
}
