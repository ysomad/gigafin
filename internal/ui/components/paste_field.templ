package components

import "github.com/ysomad/gigafin/internal/ui/view"

// PasteField takes the content of the file pasted instead, with the header of the
// file as placeholder, and the message err about the file.
templ PasteField(header, content, err string) {
	@Field("", view.T(ctx, "Or paste the file content"), err, "file-error", nil) {
		<textarea name="content" rows="8" placeholder={ header } { view.Invalid(err, "file-error")... }>{ content }</textarea>
	}
}
