package components

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// AccountKindSelect picks the kind of an account, shows and hides the credit limit
// field by app.js.
templ AccountKindSelect(kinds []domain.AccountKind, selected, err string) {
	<select name="kind" data-account-kind { view.Invalid(err, "kind-error")... }>
		for _, k := range kinds {
			<option value={ string(k) } selected?={ string(k) == selected }>{ view.T(ctx, string(k)) }</option>
		}
	</select>
}
