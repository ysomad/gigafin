package components

import (
	"github.com/ysomad/gigafin/internal/timex"
	"github.com/ysomad/gigafin/internal/ui/view"
)

// MonthOptions are the options of months, selected the one equal to selected.
templ MonthOptions(months []timex.Month, selected timex.Month) {
	for _, m := range months {
		<option value={ m.String() } selected?={ m.String() == selected.String() }>{ view.MonthName(ctx, m.First()) }</option>
	}
}
