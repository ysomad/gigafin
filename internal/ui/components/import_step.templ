package components

import "strconv"

// ImportStep is a mapping step of a staged import: a link to href while staged,
// selected if current, checked if done, numbered num otherwise.
templ ImportStep(staged, current bool, href string, done bool, num, label string) {
	{{
		mark := num
		if done {
			mark = "✓"
		}
	}}
	if staged {
		<a role="tab" aria-selected={ strconv.FormatBool(current) } href={ templ.SafeURL(href) }>{ mark } { label }</a>
	} else {
		<span role="tab" aria-selected="false">{ mark } { label }</span>
	}
}
