package pages

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ Categories(v view.Page) {
	{{ d, _ := v.Data.(view.Categories) }}
	@components.Layout(v, true, nil) {
		<div class="hstack justify-between mb-4">
			<a class="button" href={ templ.SafeURL(fmt.Sprintf("/categories/new?kind=%s", d.Kind)) }>+ { view.T(ctx, "New category") }</a>
			<div class="hstack">
				for _, k := range domain.Kinds() {
					@components.SegmentLink(fmt.Sprintf("/categories?kind=%s", k), k == d.Kind, view.KindLabel(ctx, k))
				}
			</div>
		</div>
		<div class="table">
			<table>
				<thead><tr><th>{ view.T(ctx, "Name") }</th></tr></thead>
				<tbody>
					{{ tree := domain.ByKind(d.Categories, d.Kind) }}
					for _, parent := range tree {
						<tr>
							<td>
								<a href={ templ.SafeURL(fmt.Sprintf("/categories/%d", parent.ID)) }>{ parent.Name }</a>
								if parent.Archived {
									@components.ArchivedBadge()
								}
							</td>
						</tr>
						for _, c := range parent.Children {
							<tr>
								<td>
									<span class="text-light">{ parent.Name } › </span><a href={ templ.SafeURL(fmt.Sprintf("/categories/%d", c.ID)) }>{ c.Name }</a>
									if c.Archived {
										@components.ArchivedBadge()
									}
								</td>
							</tr>
						}
					}
					if len(tree) == 0 {
						<tr><td class="text-light">{ view.T(ctx, "No categories yet.") }</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}
