package pages

import (
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ Settings(v view.Page) {
	{{ d, _ := v.Data.(view.Settings) }}
	@components.Layout(v, false, components.SettingsToasts(d)) {
		<div class="hstack justify-between mb-4">
			<div class="hstack">
				@components.LinkButton("/accounts", "secondary", view.T(ctx, "Accounts"))
				@components.LinkButton("/categories", "secondary", view.T(ctx, "Categories"))
				@components.LinkButton("/rules", "secondary", view.T(ctx, "Rules"))
				@components.LinkButton("/imports", "secondary", view.T(ctx, "Import"))
			</div>
			<form method="post" action="/logout" class="hstack">
				<span>{ view.T(ctx, "Signed in as") } <strong>{ v.User.Login }</strong></span>
				<button type="submit" class="outline small" data-variant="secondary">{ view.T(ctx, "Sign out") }</button>
			</form>
		</div>
		// Settings are one form, saved as a whole on change; it swaps in its card of the
		// page the server answers with, the cards showing what it changes, and the toasts.
		// Every action form is one row, its button in the last column under an empty
		// caption, spaced as an input under its label, and swaps in just its own card.
		@components.GeneralCard(v, d)
		<article id="settings-password" class="card mb-4 form-compact">
			<h3>{ view.T(ctx, "Password") }</h3>
			<form id="form-password" method="post" action="/settings/password" class="row" { view.HXCard("/settings/password", "settings-password", "#toasts,#settings-access")... }>
				@components.FormError(v.Errors.Form("password"), "col-12")
				{{ e := v.Errors.Get("password.current") }}
				@components.Field("col-3", view.T(ctx, "Current password"), e, "current-password-error", nil) {
					<input type="password" name="current" autocomplete="current-password" { view.Invalid(e, "current-password-error")... }/>
				}
				{{ e = v.Errors.Get("password.password") }}
				@components.Field("col-3", view.T(ctx, "New password"), e, "new-password-error", nil) {
					<input type="password" name="password" autocomplete="new-password" { view.Invalid(e, "new-password-error")... }/>
				}
				@components.SubmitColumn("col-3", "", view.T(ctx, "Change password"))
			</form>
		</article>
		@components.RatesCard(v, d)
		@components.AccessCard(v, d)
		<article class="card mb-4 form-compact">
			<h3>{ view.T(ctx, "Export") }</h3>
			<p class="text-light">{ view.T(ctx, "Without dates, data of all time is exported.") }</p>
			<form method="get" action="/settings/export" hx-boost="false" class="row">
				<input type="hidden" name="format" value="csv"/>
				@components.Field("col-3", view.T(ctx, "From"), "", "", nil) {
					<input type="date" name="from"/>
				}
				@components.Field("col-3", view.T(ctx, "To"), "", "", nil) {
					<input type="date" name="to"/>
				}
				@components.SubmitColumn("col-3", "", view.T(ctx, "Export")+" CSV")
			</form>
		</article>
		if d.CanBackup {
			<article class="card mb-4 form-compact">
				<h3>{ view.T(ctx, "Backup") }</h3>
				<p class="text-light">{ view.T(ctx, "The whole database of all users, encrypted with") } <a href="https://age-encryption.org">age</a>.</p>
				<form method="post" action="/settings/backup" hx-boost="false" class="row">
					@components.FormError(v.Errors.Form("backup"), "col-12")
					{{ e := v.Errors.Get("backup.password") }}
					@components.Field("col-3", view.T(ctx, "Current password"), e, "backup-password-error", nil) {
						<input type="password" name="password" autocomplete="current-password" { view.Invalid(e, "backup-password-error")... }/>
					}
					{{ e = v.Errors.Get("backup.passphrase") }}
					@components.Field("col-3", view.T(ctx, "Backup passphrase"), e, "backup-passphrase-error", nil) {
						<input type="password" name="passphrase" autocomplete="new-password" { view.Invalid(e, "backup-passphrase-error")... }/>
					}
					@components.SubmitColumn("col-3", "", view.T(ctx, "Download backup"))
				</form>
			</article>
		}
		<article id="settings-delete" class="card form-compact">
			<h3>{ view.T(ctx, "Danger zone") }</h3>
			<p><strong>{ view.T(ctx, "Delete all data") }</strong>: { view.T(ctx, "every account, operation, category, plan and import, plus saved import mappings. Your login, password, time zone, sessions and API keys stay. This cannot be undone.") }</p>
			<form id="form-delete" method="post" action="/settings/delete-data" class="row" { view.HXCard("/settings/delete-data", "settings-delete", "#toasts")... } hx-confirm={ view.T(ctx, "Delete all accounts, operations, categories, plans and imports? This cannot be undone.") }>
				@components.FormError(v.Errors.Form("delete"), "col-12")
				{{ e = v.Errors.Get("delete.password") }}
				@components.Field("col-3", view.T(ctx, "Current password"), e, "delete-password-error", nil) {
					<input type="password" name="password" autocomplete="current-password" { view.Invalid(e, "delete-password-error")... }/>
				}
				@components.SubmitColumn("col-3", "danger", view.T(ctx, "Delete all data"))
			</form>
		</article>
	}
}
