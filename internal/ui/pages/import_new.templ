package pages

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ ImportNew(v view.Page) {
	{{ d, _ := v.Data.(view.ImportNew) }}
	@components.Layout(v, false, nil) {
		<h1>{ view.T(ctx, "New import") }</h1>
		@components.ImportSteps(d.Step, d.Rates, nil)
		if d.Step == "type" {
			<form method="get" action="/imports/new">
				<fieldset class="w-100">
					<legend>{ view.T(ctx, "What are you importing?") }</legend>
					<div class="vstack gap-2">
						<label><input type="radio" name="source" value="gigafin" checked/> { view.T(ctx, "Gigafin operations") } <span class="text-light">CSV</span></label>
						<label><input type="radio" name="source" value="tbank"/> { view.T(ctx, "T-Bank operations") } <span class="text-light">CSV</span></label>
						<label><input type="radio" name="source" value="zenmoney"/> { view.T(ctx, "Zenmoney operations") } <span class="text-light">CSV</span></label>
						<label><input type="radio" name="source" value="rates"/> { view.T(ctx, "Exchange rates") } <span class="text-light">CSV</span></label>
					</div>
				</fieldset>
				<div class="hstack mb-4">
					@components.LinkButton("/imports", "secondary", view.T(ctx, "Cancel"))
					<button type="submit">{ view.T(ctx, "Next") }</button>
				</div>
			</form>
		} else if d.Rates {
			{{ e := v.Errors.Get("file") }}
			<form id="form-import-rates" method="post" action="/imports/rates" enctype="multipart/form-data" hx-disable="find button">
				@components.FormError(v.Errors.Form("import-rates"), "")
				@components.Field("", view.T(ctx, "CSV file"), "", "", nil) {
					@components.FileInput(e)
					<small data-hint>{ view.T(ctx, "exchange rates") }</small>
				}
				<div class="mb-4">
					<p class="text-light">UTF-8, <code>,</code>{ view.T(ctx, "-separated, header row, the format of Actual Budget. Columns:") }</p>
					@components.CsvColumns() {
						<tr><td><code>date</code></td><td>YYYY-MM-DD</td></tr>
						<tr><td><code>from</code></td><td>USD, EUR, …</td></tr>
						<tr><td><code>to</code></td><td>{ view.T(ctx, "the currency of your") } <a href="/settings">{ view.T(ctx, "rate source") }</a>{ view.T(ctx, ", e.g. RUB") }</td></tr>
						<tr><td><code>rate</code></td><td>{ view.T(ctx, "price of one") } <code>from</code> { view.T(ctx, "in") } <code>to</code>{ view.T(ctx, ", decimal point") }</td></tr>
					}
					<p class="text-light">{ view.T(ctx, "Days missing between rows of a currency carry the previous rate. Imported rates replace stored ones and are kept by updates.") }</p>
				</div>
				@components.PasteField(d.Header, d.Content, e)
				@components.UploadButtons()
			</form>
		} else {
			{{ e := v.Errors.Get("file") }}
			<form id="form-import" method="post" action="/imports" enctype="multipart/form-data" hx-disable="find button">
				@components.FormError(v.Errors.Form("import"), "")
				<input type="hidden" name="source" value={ string(d.Source) }/>
				switch d.Source {
					case domain.ImportSourceTBank:
						@components.Field("", view.T(ctx, "T-Bank CSV export"), "", "", nil) {
							@components.FileInput(e)
							<small data-hint>{ view.T(ctx, "T-Bank app or site: Operations → Export → CSV.") }</small>
						}
					case domain.ImportSourceZenMoney:
						@components.Field("", view.T(ctx, "Zenmoney CSV export"), "", "", nil) {
							@components.FileInput(e)
						}
						<p class="text-light">{ view.T(ctx, "Times are read in your") } <a href="/settings">{ view.T(ctx, "time zone") }</a>{ view.T(ctx, ", keep it equal to Zenmoney's. Cross-currency transfers are skipped.") }</p>
					default:
						@components.Field("", view.T(ctx, "CSV file"), "", "", nil) {
							@components.FileInput(e)
							<small data-hint>{ view.T(ctx, "gigafin format") }</small>
						}
						<div class="mb-4">
							<p class="text-light">UTF-8, <code>;</code>{ view.T(ctx, "-separated, header row. Columns:") }</p>
							@components.CsvColumns() {
								<tr><td><code>date</code></td><td>YYYY-MM-DD</td></tr>
								<tr><td><code>time</code></td><td>HH:MM <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
								<tr><td><code>account</code></td><td>{ view.T(ctx, "account name") }</td></tr>
								<tr><td><code>amount</code></td><td>{ view.T(ctx, "negative is money out") }</td></tr>
								<tr><td><code>currency</code></td><td>RUB, USD, …</td></tr>
								<tr><td><code>category</code></td><td>Cat1 / Cat2 <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
								<tr><td><code>payee</code>, <code>note</code></td><td>{ view.T(ctx, "free text") }</td></tr>
								<tr><td><code>to_account</code></td><td>{ view.T(ctx, "makes a transfer") } <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
								<tr><td><code>mcc</code></td><td>{ view.T(ctx, "4 digits") } <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
								<tr><td><code>origin_id</code></td><td>{ view.T(ctx, "rows sharing it form one split operation") } <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
								<tr><td><code>tags</code></td><td>{ view.T(ctx, "names separated by") } <code>,</code> <span class="text-light">{ view.T(ctx, "optional") }</span></td></tr>
							}
						</div>
				}
				@components.PasteField(d.Header, d.Content, e)
				<p class="text-light">{ view.T(ctx, "Rows imported before are skipped.") }</p>
				@components.UploadButtons()
			</form>
		}
	}
}
