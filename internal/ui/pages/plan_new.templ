package pages

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ PlanNew(v view.Page) {
	{{ d, _ := v.Data.(view.PlanNew) }}
	@components.Layout(v, false, nil) {
		<h1>{ view.T(ctx, "New plan") }</h1>
		<form id="form-plan" class="form-compact" method="post" action="/plans">
			@components.FormError(v.Errors.Form("plan"), "")
			<input type="hidden" name="new" value="true"/>
			<fieldset class="row mb-4">
				@components.Field("col-6", view.T(ctx, "Month"), "", "", nil) {
					<select name="month">
						@components.MonthOptions(d.Months, d.Month)
					</select>
				}
				{{ e := v.Errors.Get("category") }}
				@components.Field("col-6", view.T(ctx, "Category"), e, "category-error", nil) {
					<select name="category" { view.Invalid(e, "category-error")... }>
						for _, k := range domain.Kinds() {
							<optgroup label={ view.KindLabel(ctx, k) }>
								@components.CategoryOptions(domain.ByKind(d.Categories, k), d.Posted.Category)
							</optgroup>
						}
					</select>
				}
				{{ e = v.Errors.Get("currency") }}
				@components.Field("col-6", view.T(ctx, "Currency"), e, "currency-error", nil) {
					@components.CurrencySelect(d.Currencies, d.Posted.Currency, e)
				}
				{{ e = v.Errors.Get("amount") }}
				@components.Field("col-6", view.T(ctx, "Amount"), e, "amount-error", nil) {
					<input name="amount" inputmode="decimal" value={ d.Posted.Amount } { view.Invalid(e, "amount-error")... }/>
				}
				@components.Field("col-12", "", "", "", nil) {
					<input type="checkbox" name="repeating" value="true" checked?={ d.Posted.Repeating }/> { view.T(ctx, "Repeat every month") }
				}
			</fieldset>
			<div class="hstack">
				<button type="submit">{ view.T(ctx, "Create") }</button>
				@components.LinkButton("/plans?month="+d.Month.String(), "secondary", view.T(ctx, "Cancel"))
			</div>
		</form>
	}
}
