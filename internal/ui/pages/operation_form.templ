package pages

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ OperationForm(v view.Page) {
	{{
		d, _ := v.Data.(view.OpForm)
		typ := string(d.Type)
		editing := d.ID != 0
		// errID is the id of the message about input name; the new operation page has
		// a form per type
		errID := func(name string) string { return name + "-error-" + typ }
	}}
	@components.Layout(v, false, nil) {
		<h1>
			if editing {
				{ view.T(ctx, "Edit %s", view.T(ctx, typ)) }
			} else {
				{ view.T(ctx, "New %s", view.T(ctx, typ)) }
			}
		</h1>
		if editing && d.ImportID != 0 {
			<p class="text-light mb-4">{ view.T(ctx, "Imported in") } <a href={ templ.SafeURL(fmt.Sprintf("/imports/%d", d.ImportID)) }>{ view.T(ctx, "import #%d", d.ImportID) }</a></p>
		}
		if !editing {
			<div class="hstack mb-4">
				@components.SegmentLink("/operations/new?type=expense", d.Type == domain.OpExpense, "− "+view.T(ctx, "Expense"))
				@components.SegmentLink("/operations/new?type=income", d.Type == domain.OpIncome, "+ "+view.T(ctx, "Income"))
				@components.SegmentLink("/operations/new?type=transfer", d.Type == domain.OpTransfer, "⇄ "+view.T(ctx, "Transfer"))
			</div>
		}
		<form
			if editing {
				id="form-operation"
			} else {
				id={ "op-form-" + typ }
				hx-post="/operations"
				hx-select={ "#op-form-" + typ }
				hx-select-oob="#toasts"
				hx-target="this"
				hx-swap="outerHTML ignoreTitle:true"
			}
			class="form-compact"
			method="post"
			if editing {
				action={ templ.SafeURL(fmt.Sprintf("/operations/%d", d.ID)) }
			} else {
				action="/operations"
			}
		>
			@components.FormError(v.Errors.Form("operation"), "")
			<input type="hidden" name="type" value={ typ }/>
			if d.ImportID != 0 {
				<input type="hidden" name="import_id" value={ d.ImportID }/>
			}
			if d.OriginID != 0 {
				<input type="hidden" name="origin_id" value={ d.OriginID }/>
			}
			<fieldset class="row mb-4" aria-label={ view.T(ctx, "Operation details") }>
				{{ e := v.Errors.Get("account") }}
				{{ accountLabel := view.T(ctx, "Account") }}
				if d.Type == domain.OpTransfer {
					{{ accountLabel = view.T(ctx, "From") }}
				}
				@components.Field("col-6", accountLabel, e, errID("account"), nil) {
					<select name="account" { view.Invalid(e, errID("account"))... }>
						@components.AccountOptions(d.Accounts, d.AccountID, editing)
					</select>
				}
				if d.Type == domain.OpTransfer {
					{{ e := v.Errors.Get("to_account") }}
					@components.Field("col-6", view.T(ctx, "To"), e, errID("to-account"), nil) {
						<select name="to_account" { view.Invalid(e, errID("to-account"))... }>
							<option value="">—</option>
							@components.AccountOptions(d.Accounts, d.ToAccountID, editing)
						</select>
					}
				}
				if d.Type == domain.OpExpense || d.Type == domain.OpIncome {
					{{ e := v.Errors.Get("category") }}
					@components.Field("col-6", view.T(ctx, "Category"), e, errID("category"), nil) {
						<select name="category" { view.Invalid(e, errID("category"))... }>
							<option value="">—</option>
							@components.CategoryOptions(d.Categories, d.CategoryID)
						</select>
					}
				}
				{{ e = v.Errors.Get("amount") }}
				@components.Field("col-12", view.T(ctx, "Amount"), e, errID("amount"), nil) {
					<input name="amount" inputmode="decimal" autocomplete="off" value={ view.AmountInput(ctx, d.Amount) } { view.Invalid(e, errID("amount"))... }/>
				}
			</fieldset>
			<fieldset class="row mb-4" aria-label={ view.T(ctx, "Date and payee") }>
				{{ e = v.Errors.Get("date") }}
				<div
					data-field
					class="col-12"
					if e != "" {
						aria-invalid="true"
					}
				>
					<label for={ "date-" + typ }>{ view.T(ctx, "Date") }</label>
					<fieldset class="group">
						<input
							type="date"
							id={ "date-" + typ }
							name="date"
							value={ d.Date }
							if e != "" {
								aria-describedby={ errID("date") }
							}
						/>
						<input type="time" name="time" value={ d.Time } aria-label={ view.T(ctx, "Time") }/>
					</fieldset>
					@components.FieldError(e, errID("date"))
				</div>
				{{ e = v.Errors.Get("payee") }}
				@components.Field("col-12", view.T(ctx, "Payee"), e, errID("payee"), nil) {
					<input
						name="payee"
						value={ d.Payee }
						autocomplete="off"
						{ view.Invalid(e, errID("payee"))... }
						if !editing {
							hx-post="/operations/fill"
							hx-trigger="change"
							hx-select={ "#op-form-" + typ }
							hx-target="closest form"
							hx-swap="outerHTML ignoreTitle:true"
						}
					/>
				}
			</fieldset>
			if d.SourcePayee != "" && d.SourcePayee != d.Payee {
				<p class="text-light">{ view.T(ctx, "Bank payee") }: { d.SourcePayee }</p>
			}
			{{ e = v.Errors.Get("note") }}
			@components.Field("", view.T(ctx, "Note"), e, errID("note"), nil) {
				<input name="note" value={ d.Note } { view.Invalid(e, errID("note"))... }/>
			}
			@components.TagsField("operation-tags-"+typ, "all-tags-"+typ, d.Tags, view.T(ctx, "Add tags with Enter or comma"), d.AllTags, v.Errors.Get("tags"), "")
			<div class="hstack justify-between">
				<div class="hstack">
					<button type="submit">{ view.T(ctx, "Save") }</button>
					if editing && (d.Type == domain.OpExpense || d.Type == domain.OpIncome) {
						@components.LinkButton(fmt.Sprintf("/operations/%d/split", d.ID), "secondary", view.T(ctx, "Split"))
					}
					if editing {
						@components.LinkButton("/operations", "secondary", view.T(ctx, "Cancel"))
					}
				</div>
				if editing {
					<button type="submit" form="op-delete" class="outline" data-variant="danger">{ view.T(ctx, "Delete") }</button>
				}
			</div>
		</form>
		if editing {
			<form id="op-delete" method="post" action={ templ.SafeURL(fmt.Sprintf("/operations/%d/delete", d.ID)) } hx-confirm={ view.T(ctx, "Delete this operation?") }></form>
		}
	}
}
