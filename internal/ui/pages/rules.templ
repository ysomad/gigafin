package pages

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ Rules(v view.Page) {
	{{ d, _ := v.Data.(view.Rules) }}
	@components.Layout(v, false, nil) {
		<div class="hstack mb-4">
			<a class="button" href="/rules/new">+ { view.T(ctx, "New rule") }</a>
		</div>
		<p class="text-light">{ view.T(ctx, "Rules run when importing or creating operations.") }</p>
		for _, s := range d.Stages {
			<h2>{ view.RuleStageLabel(ctx, s.Stage) }</h2>
			<ul class="vstack">
				for _, r := range s.Rules {
					<li>
						<a href={ templ.SafeURL(fmt.Sprintf("/rules/%d", r.ID)) }>
							{ view.T(ctx, "If") }
							for i, c := range r.Conds {
								{{
									join := ""
									if i > 0 && c.Any {
										join = view.T(ctx, "or") + " "
									} else if i > 0 {
										join = view.T(ctx, "and") + " "
									}
								}}
								{ join + view.RuleFieldLabel(ctx, c.Field) } { view.RuleOpLabel(ctx, c.Op) } <strong>{ c.Values }</strong>
							}
							→
							for i, a := range r.Actions {
								{{
									sep := ""
									if i < len(r.Actions)-1 {
										sep = ", "
									}
								}}
								if a.Value != "" {
									{ view.RuleActionLabel(ctx, a.Type) } <strong>{ a.Value }</strong>{ sep }
								} else {
									{ view.RuleActionLabel(ctx, a.Type) + sep }
								}
							}
						</a>
						if r.Origin == domain.RuleOriginLearned {
							@components.LearnedBadge()
						}
					</li>
				}
			</ul>
		}
		if len(d.Stages) == 0 {
			<p class="text-light">{ view.T(ctx, "No rules yet.") }</p>
		}
	}
}
