package pages

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/components"
	"github.com/ysomad/gigafin/internal/ui/view"
)

templ Import(v view.Page) {
	{{
		d, _ := v.Data.(view.Import)
		p := d.Preview
		base := fmt.Sprintf("/imports/%d", p.Import.ID)
		staged := p.Import.Status == domain.ImportStaged
	}}
	@components.Layout(v, true, nil) {
		<h1>{ view.T(ctx, "Import #%d", p.Import.ID) }</h1>
		<p class="hstack mb-4">
			<span class="text-light">{ p.Import.Filename }</span>
			@components.ImportStatusBadge(p.Import.Status)
			<span class="badge" data-variant="success">{ view.T(ctx, "%d new", p.Import.RowsNew) }</span>
			<span class="badge" data-variant="secondary">{ view.T(ctx, "%d already imported", p.Import.RowsDup) }</span>
			if len(p.Skipped) > 0 {
				<a class="badge" data-variant="warning" href={ templ.SafeURL(base + "/preview#skipped") }>{ view.T(ctx, "%d skipped", p.Import.RowsSkip) }</a>
			} else {
				<span class="badge" data-variant="secondary">{ view.T(ctx, "%d skipped", p.Import.RowsSkip) }</span>
			}
		</p>
		@components.ImportSteps(d.Step, false, &p)
		switch d.Step {
			case "accounts":
				if len(p.Accounts) > 0 {
					@components.ImportAccounts(d, base)
				} else {
					<p class="text-light">{ view.T(ctx, "No accounts to map.") }</p>
					<div class="hstack mb-4">
						@components.DiscardButton(base, view.T(ctx, "Cancel"))
						<a class="button" href={ templ.SafeURL(base + "/categories") }>{ view.T(ctx, "Next") }</a>
					</div>
				}
			case "categories":
				if len(p.Categories) > 0 {
					@components.ImportCategories(d, base)
				} else {
					<p class="text-light">{ view.T(ctx, "No categories to map.") }</p>
					<div class="hstack mb-4">
						@components.DiscardButton(base, view.T(ctx, "Cancel"))
						@components.LinkButton(base+"/accounts", "secondary", view.T(ctx, "Back"))
						<a class="button" href={ templ.SafeURL(base + "/preview") }>{ view.T(ctx, "Next") }</a>
					</div>
				}
			case "preview":
				<div class="hstack mb-4">
					switch p.Import.Status {
						case domain.ImportStaged:
							@components.DiscardButton(base, view.T(ctx, "Cancel"))
							@components.LinkButton(base+"/categories", "secondary", view.T(ctx, "Back"))
							<form method="post" action={ templ.SafeURL(base + "/commit") } hx-disable="find button">
								<button type="submit" data-spinner disabled?={ !p.Ready() }>{ view.T(ctx, "Import %d rows", p.Import.RowsNew) }</button>
							</form>
						case domain.ImportCommitted:
							<form method="post" action={ templ.SafeURL(base + "/undo") } hx-confirm={ view.T(ctx, "Delete all operations created by this import?") }>
								<button type="submit" class="outline" data-variant="secondary">{ view.T(ctx, "Undo import") }</button>
							</form>
						default:
							@components.DiscardButton(base, view.T(ctx, "Delete from history"))
					}
				</div>
				if staged && !p.AccountsMapped() {
					<p role="alert" data-variant="warning">{ view.T(ctx, "Some accounts are not mapped yet.") } <a href={ templ.SafeURL(base + "/accounts") }>{ view.T(ctx, "Map accounts") }</a></p>
				}
				if staged && !p.CategoriesMapped() {
					<p role="alert" data-variant="warning">{ view.T(ctx, "Some categories are not mapped yet.") } <a href={ templ.SafeURL(base + "/categories") }>{ view.T(ctx, "Map categories") }</a></p>
				}
				@components.ImportRows(p, base, v.User)
		}
	}
}
