package kit

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
)

// EmptyRow is a table row of msg over colspan columns.
templ EmptyRow(colspan int, msg string) {
	<tr><td colspan={ colspan } class="text-light">{ msg }</td></tr>
}

// BankLogo is the logo of bank, titled with title, or its name for a bank without one.
templ BankLogo(bank domain.Bank, title string) {
	switch bank {
		case domain.BankTBank:
			<img src="/static/banks/tbank.svg" width="16" height="16" alt={ title } title={ title }/>
		default:
			<span class="badge outline" title={ title }>{ T(ctx, bank.Name()) }</span>
	}
}

// BankBadge warns that the balance of account a differs from the balance of the bank
// account t it syncs with by the difference, signed as a is off, titled with the
// bank's balance. Amounts show minor units, as the difference may be less than one.
templ BankBadge(t domain.BankAccount, a domain.Account) {
	{{
		diff := a.Balance.Sub(t.Balance).Format(t.Currency)
		if a.Balance.Cmp(t.Balance) > 0 {
			diff = "+" + diff
		}
	}}
	<span class="badge" data-variant="warning" title={ T(ctx, "Bank balance: %s", t.Balance.Format(t.Currency)) }>{ diff }</span>
}

templ ArchivedBadge() {
	<span class="badge" data-variant="secondary">{ T(ctx, "archived") }</span>
}

// ArchiveDelete are the archive, or unarchive if archived, and delete buttons of the
// edit form of an account or a category, which post the ArchiveDeleteForms of prefix.
templ ArchiveDelete(prefix string, archived bool) {
	<div class="hstack">
		<button type="submit" form={ prefix + "-archive" } class="outline" data-variant="secondary">
			if archived {
				{ T(ctx, "Unarchive") }
			} else {
				{ T(ctx, "Archive") }
			}
		</button>
		<button type="submit" form={ prefix + "-delete" } class="outline" data-variant="danger">{ T(ctx, "Delete") }</button>
	</div>
}

// ArchiveDeleteForms are the forms of ArchiveDelete, put outside the edit form:
// archiving at base + "/archive", deleting after confirm at base + "/delete".
templ ArchiveDeleteForms(prefix, base string, archived bool, confirm string) {
	<form id={ prefix + "-archive" } method="post" action={ base + "/archive" }>
		<input
			type="hidden"
			name="archived"
			if archived {
				value="0"
			} else {
				value="1"
			}
		/>
	</form>
	<form id={ prefix + "-delete" } method="post" action={ base + "/delete" } hx-confirm={ confirm }></form>
}

// Filter is the filter form of a list, getting action: a button opening its dialog,
// showing how many of count filters and the search query are set, and a link to
// reset, the unfiltered list, if any. The dialog has the search input of query, then
// the fields of children.
templ Filter(action, query string, count int, reset string) {
	{{
		if query != "" {
			count++
		}
	}}
	<form method="get" action={ action }>
		<div class="hstack">
			<button type="button" class="outline" commandfor="filter-dialog" command="show-modal" aria-label={ T(ctx, "Filter") }>
				<svg width="16" height="16" aria-hidden="true"><use href="/static/icons.svg#funnel"></use></svg>
				if count > 0 {
					<span class="badge">{ count }</span>
				}
			</button>
			if reset != "" {
				<a class="button ghost" href={ reset }>{ T(ctx, "Reset") }</a>
			}
		</div>
		// outside the hstack, which zeroes the margins that center a dialog
		<dialog id="filter-dialog" class="p-4 form-compact" aria-label={ T(ctx, "Filter") } closedby="any" autofocus>
			<div class="row">
				@Field("col-12", T(ctx, "Search"), "", "", nil) {
					<input type="search" name="q" value={ query } autocomplete="off"/>
				}
				{ children... }
			</div>
			<footer class="hstack justify-end mt-4">
				<button type="button" class="outline" commandfor="filter-dialog" command="close">{ T(ctx, "Close") }</button>
				<button type="submit">{ T(ctx, "Apply") }</button>
			</footer>
		</dialog>
	</form>
}

// NoOperations is the text of a page that would list operations when the user has none.
templ NoOperations() {
	<p class="text-light">{ T(ctx, "No operations yet.") } <a href="/operations/new?type=expense">{ T(ctx, "Add one") }</a> { T(ctx, "or") } <a href="/imports/new">{ T(ctx, "import") }</a>.</p>
}

// OpRows are the list items of operations by day, followed by the loader of moreURL,
// the next page, if any.
templ OpRows(days []DayGroup, catNames map[int64]string, accByID map[int64]domain.Account, moreURL string) {
	for _, day := range days {
		if !day.Continued {
			<li class="day text-light mt-4">{ DayTitle(ctx, day.Date) }</li>
		}
		for _, op := range day.Ops {
			<li class="card compact hstack justify-between">
				<a href={ fmt.Sprintf("/operations/%d/edit", op.ID) }>
					<div class="hstack gap-1">
						{ OpCategory(ctx, op, catNames) }
						if op.IsSplit() {
							<svg width="14" height="14" role="img" aria-label={ T(ctx, "Part of a split") }><title>{ T(ctx, "Part of a split") }</title><use href="/static/icons.svg#split"></use></svg>
						}
					</div>
					<small class="flex flex-col text-light">
						<span class="hstack gap-1">
							<svg width="12" height="12" role="img" aria-label={ T(ctx, "Account") }><title>{ T(ctx, "Account") }</title><use href="/static/icons.svg#wallet"></use></svg>
							{ OpAccounts(op, accByID) }
						</span>
						if op.Payee != "" {
							<span class="hstack gap-1">
								<svg width="12" height="12" role="img" aria-label={ T(ctx, "Payee") }><title>{ T(ctx, "Payee") }</title><use href="/static/icons.svg#store"></use></svg>
								{ op.Payee }
							</span>
						}
						if op.Note != "" {
							<span class="hstack gap-1">
								<svg width="12" height="12" role="img" aria-label={ T(ctx, "Note") }><title>{ T(ctx, "Note") }</title><use href="/static/icons.svg#message-square"></use></svg>
								{ op.Note }
							</span>
						}
					</small>
				</a>
				<div class="align-right">{ OpAmount(ctx, op) } <span class="text-light">{ money.CurrencySymbol(op.Currency) }</span></div>
			</li>
		}
	}
	if moreURL != "" {
		<li id="more" hx-get={ moreURL } hx-trigger="revealed" hx-swap="outerHTML" aria-busy="true"></li>
	}
}
