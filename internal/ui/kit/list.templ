package kit

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
)

// EmptyRow is a table row of msg over colspan columns.
templ EmptyRow(colspan int, msg string) {
	<tr><td colspan={ colspan } class="text-light">{ msg }</td></tr>
}

// BankLogo is the logo of bank, titled with title, or its name for a bank without one.
templ BankLogo(bank domain.Bank, title string) {
	switch bank {
		case domain.BankTBank:
			<img src="/static/img/tbank.svg" width="16" height="16" alt={ title } title={ title }/>
		default:
			<span class="badge outline" title={ title }>{ T(ctx, bank.Name()) }</span>
	}
}

// BankBadge warns that the balance of account a differs from the balance of the bank
// account t it syncs with by the difference, signed as a is off, titled with the
// bank's balance. Amounts show minor units, as the difference may be less than one.
templ BankBadge(t domain.BankAccount, a domain.Account) {
	{{
		diff := a.Balance.Sub(t.Balance).Format(t.Currency)
		if a.Balance.Cmp(t.Balance) > 0 {
			diff = "+" + diff
		}
	}}
	<span class="badge" data-variant="warning" data-amount title={ T(ctx, "Bank balance: %s", t.Balance.Format(t.Currency)) }>{ diff }</span>
}

templ ArchivedBadge() {
	<span class="badge" data-variant="secondary">{ T(ctx, "archived") }</span>
}

// ArchiveDelete are the archive, or unarchive if archived, and delete buttons of the
// edit form of an account or a category, which post the ArchiveDeleteForms of prefix.
templ ArchiveDelete(prefix string, archived bool) {
	<div class="hstack">
		<button type="submit" form={ prefix + "-archive" } class="outline" data-variant="secondary">
			if archived {
				{ T(ctx, "Unarchive") }
			} else {
				{ T(ctx, "Archive") }
			}
		</button>
		<button type="submit" form={ prefix + "-delete" } class="outline" data-variant="danger">{ T(ctx, "Delete") }</button>
	</div>
}

// ArchiveDeleteForms are the forms of ArchiveDelete, put outside the edit form:
// archiving at base + "/archive", deleting after confirm at base + "/delete".
templ ArchiveDeleteForms(prefix, base string, archived bool, confirm string) {
	<form id={ prefix + "-archive" } method="post" action={ base + "/archive" }>
		<input
			type="hidden"
			name="archived"
			if archived {
				value="0"
			} else {
				value="1"
			}
		/>
	</form>
	<form id={ prefix + "-delete" } method="post" action={ base + "/delete" } hx-confirm={ confirm }></form>
}

// Filter is the toolbar of a list getting action: buttons opening the search of query,
// hinted by placeholder, and the dialog of the filter form, showing how many filters,
// count, are set, and a link to reset, the unfiltered list, if any. The dialog has the
// fields of children. The search swaps in the results of the list, list-results.
templ Filter(action, query, placeholder string, count int, reset string) {
	<div>
		<div class="hstack">
			<menu class="buttons">
				<li>
					@SearchButton()
				</li>
				<li>
					@FilterButton(count)
				</li>
			</menu>
			@ResetButton(reset)
		</div>
		// outside the hstack, which zeroes the margins that center a dialog
		@SearchDialog(action, query, placeholder)
		@FilterDialog(action) {
			{ children... }
		}
	</div>
}

// NewButton is the button of a list toolbar adding the item labeled label at href, with
// attrs, such as to get the form into a dialog. On phones a button floating under the
// thumb replaces it.
templ NewButton(href, label string, attrs templ.Attributes) {
	<a class="button new-button" href={ href } { attrs... }>+ { label }</a>
	<a class="button outline fab" href={ href } aria-label={ label } { attrs... }>+</a>
}

// SearchButton opens the dialog of SearchDialog.
templ SearchButton() {
	<button type="button" class="outline" commandfor="search" command="toggle-popover" aria-label={ T(ctx, "Search") }>
		<svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#search"></use></svg>
	</button>
}

// SearchDialog is the dialog of the search input of query, hinted by placeholder, of a
// list getting action. The input belongs to the filter form, so every way of getting
// the list keeps it; typing swaps in the results and the elements of oob, as ListGet,
// Enter loads the page.
templ SearchDialog(action, query, placeholder string, oob ...string) {
	<dialog id="search" popover role="search" class="p-4" aria-label={ T(ctx, "Search") }>
		<input
			type="search"
			name="q"
			form="filter-form"
			value={ query }
			if placeholder != "" {
				placeholder={ placeholder }
			}
			aria-label={ T(ctx, "Search") }
			autocomplete="off"
			autofocus
			hx-trigger="input changed delay:300ms, search"
			{ ListGet(action, oob...)... }
		/>
	</dialog>
}

// ResetButton links to reset, the unfiltered list, if any. It is list-reset, swapped in
// with the results of the list, and hidden without reset so the gap of its toolbar does
// not push the buttons before it off the right edge.
templ ResetButton(reset string) {
	<span id="list-reset" hidden?={ reset == "" }>
		if reset != "" {
			<a class="button ghost" href={ reset } aria-label={ T(ctx, "Reset") } title={ T(ctx, "Reset") }><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#x"></use></svg></a>
		}
	</span>
}

// FilterButton opens the dialog of FilterDialog, non-modal so the nav stays usable,
// showing how many filters, count, are set when any is.
templ FilterButton(count int) {
	<button type="button" class="outline" commandfor="filter-dialog" command="--show" aria-label={ T(ctx, "Filter") }>
		<svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#funnel"></use></svg>
		if count > 0 {
			<span class="filter-count">{ count }</span>
		}
	</button>
}

// FilterDialog is the dialog of the filter form, filter-form, of a list, getting
// action, with the fields of children. FilterButton opens it.
templ FilterDialog(action string) {
	<form id="filter-form" method="get" action={ action }>
		<dialog id="filter-dialog" aria-label={ T(ctx, "Filter") } closedby="any" autofocus>
			@DialogHeader("filter-dialog", T(ctx, "Filter"), "")
			<div class="form-compact">
				<div class="row">
					{ children... }
				</div>
			</div>
			<footer>
				<div class="hstack justify-end w-100">
					<button type="submit">{ T(ctx, "Apply") }</button>
				</div>
			</footer>
		</dialog>
	</form>
}

// NoOperations is the text of a page that would list operations when the user has none.
templ NoOperations() {
	<p class="text-light">{ T(ctx, "No operations yet.") } <a href="/operations/new?type=expense" hx-get="/operations/new?type=expense" hx-target="#op-dialog" hx-swap="innerHTML">{ T(ctx, "Add one") }</a> { T(ctx, "or") } <a href="/imports/new">{ T(ctx, "import") }</a>.</p>
}

// OpRows are the list items of operations by day, each titled with its net income, or
// each with its date in a day of zero date, followed by the loader of moreURL, the
// next page, if any.
templ OpRows(days []DayGroup, catNames map[int64]string, accByID map[int64]domain.Account, moreURL string) {
	for _, day := range days {
		if !day.Continued && !day.Date.IsZero() {
			<li class="day text-light mt-4 hstack justify-between">
				<span>{ DayTitle(ctx, day.Date) }</span>
				<span class="hstack gap-2">
					for _, fl := range day.Flows {
						{{
							net := Money(ctx, fl.Net(), fl.Currency)
							if fl.Net().IsPositive() {
								net = "+" + net
							}
						}}
						<span data-amount>{ net } { money.CurrencySymbol(fl.Currency) }</span>
					}
				</span>
			</li>
		}
		for _, op := range day.Ops {
			// data-op counts the rows loaded, which the list reloads through once an
			// operation edited in the dialog of the layout is saved
			<li class="card compact hstack justify-between" data-op>
				<a href={ fmt.Sprintf("/operations/%d/edit", op.ID) } hx-get={ fmt.Sprintf("/operations/%d/edit", op.ID) } hx-target="#op-dialog" hx-swap="innerHTML">
					<div class="hstack gap-1">
						{ OpCategory(ctx, op, catNames) }
						if op.IsSplit() {
							<svg width="14" height="14" role="img" aria-label={ T(ctx, "Part of a split") }><title>{ T(ctx, "Part of a split") }</title><use href="/static/img/icons.svg#split"></use></svg>
						}
					</div>
					<small class="flex flex-col text-light">
						<span class="hstack gap-1">
							<svg width="12" height="12" role="img" aria-label={ T(ctx, "Account") }><title>{ T(ctx, "Account") }</title><use href="/static/img/icons.svg#wallet"></use></svg>
							{ OpAccounts(op, accByID) }
						</span>
						if op.Payee != "" {
							<span class="hstack gap-1">
								<svg width="12" height="12" role="img" aria-label={ T(ctx, "Payee") }><title>{ T(ctx, "Payee") }</title><use href="/static/img/icons.svg#store"></use></svg>
								{ op.Payee }
							</span>
						}
						if op.Note != "" {
							<span class="hstack gap-1">
								<svg width="12" height="12" role="img" aria-label={ T(ctx, "Note") }><title>{ T(ctx, "Note") }</title><use href="/static/img/icons.svg#message-square"></use></svg>
								{ op.Note }
							</span>
						}
					</small>
				</a>
				<div class="align-right">
					<span data-amount>{ OpAmount(ctx, op) } <span class="text-light">{ money.CurrencySymbol(op.Currency) }</span></span>
					if day.Date.IsZero() {
						<div><small class="text-light">{ DayTitle(ctx, op.Date) }</small></div>
					}
				</div>
			</li>
		}
	}
	if moreURL != "" {
		<li id="more" hx-get={ moreURL } hx-trigger="revealed" hx-swap="outerHTML" aria-busy="true"></li>
	}
}
