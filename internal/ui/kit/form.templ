package kit

import (
	"cmp"
	"context"
	"slices"
	"strconv"
	"strings"

	"github.com/ysomad/gigafin/internal/domain"
)

// Field is a form field: a label of class with the input as children, followed by
// the message err about it, with id errID when set. attrs are added to the label.
templ Field(class, label, err, errID string, attrs templ.Attributes) {
	<label
		data-field
		class={ templ.KV(class, class != "") }
		if err != "" {
			aria-invalid="true"
		}
		{ attrs... }
	>
		{ label }
		{ children... }
		@FieldError(err, errID)
	</label>
}

// FieldError is the message err about an input, with id errID when set.
templ FieldError(err, errID string) {
	if err != "" {
		<div
			if errID != "" {
				id={ errID }
			}
			class="error"
			role="status"
		>{ err }</div>
	}
}

// FormError is the message msg about a whole form, in grid column col, if any.
templ FormError(msg, col string) {
	if msg != "" {
		<p class={ templ.KV(col, col != ""), "error" } role="alert" data-variant="error">{ msg }</p>
	}
}

// SubmitColumn is the submit button of a one-row form in a column of class, under an
// empty caption, so it lines up with the inputs under their labels.
templ SubmitColumn(class, variant, label string) {
	<div class={ class, "vstack gap-1" }>
		<label aria-hidden="true">&nbsp;</label>
		<div>
			<button
				type="submit"
				if variant != "" {
					data-variant={ variant }
				}
			>{ label }</button>
		</div>
	</div>
}

// RemoveColumn is the button labeled label removing a row of a form, in the last column
// of the row under an empty caption, so it lines up with the inputs. attrs make it
// remove the row.
templ RemoveColumn(label string, attrs templ.Attributes) {
	<div class="col-1 vstack gap-1">
		<label aria-hidden="true">&nbsp;</label>
		<div><button type="button" class="outline" aria-label={ label } title={ label } data-variant="secondary" { attrs... }>✕</button></div>
	</div>
}

// LinkButton is a link that looks like an outline button of variant.
templ LinkButton(href, variant, label string) {
	<a class="button outline" href={ href } data-variant={ variant }>{ label }</a>
}

// CurrencySelect picks one of currencies.
templ CurrencySelect(currencies []string, selected, err string) {
	<select name="currency" { Invalid(err, "currency-error")... }>
		for _, c := range currencies {
			<option selected?={ c == selected }>{ c }</option>
		}
	</select>
}

// SelectOption is an option of Select or MultiSelect.
type SelectOption struct {
	Value string
	// Label is searched by typing and shown in the input of Select when picked.
	Label string
	// Text is shown in the list and in the input of MultiSelect; Label when empty.
	Text string
	// Group is the caption put before the first option of each group.
	Group string
	// Child is indented under the option before it that is not a child.
	Child bool
	// Empty is picked when the input of Select is emptied, such as "All".
	Empty bool
}

// CategoryOptions returns the categories of tree as options, each cat2 under its cat1
// with the label "cat1 / cat2". Archived categories are left out, unless selected or
// archived is set; a cat2 of a cat1 left out is not under it. The categories of a tree
// of several kinds are grouped under their kind.
func CategoryOptions(ctx context.Context, tree []domain.Category, selected []int64, archived bool) []SelectOption {
	grouped := len(tree) > 0 && tree[0].Kind != tree[len(tree)-1].Kind
	var options []SelectOption
	for _, parent := range tree {
		var group string
		if grouped {
			group = KindLabel(ctx, parent.Kind)
		}
		shown := archived || parent.IsPickable(selected...)
		if shown {
			options = append(options, SelectOption{
				Value: strconv.FormatInt(parent.ID, 10),
				Label: parent.Name,
				Group: group,
			})
		}
		for _, c := range parent.Children {
			if archived || c.IsPickable(selected...) {
				o := SelectOption{
					Value: strconv.FormatInt(c.ID, 10),
					Label: domain.FullName(parent.Name, c.Name),
					Group: group,
				}
				if shown {
					o.Text, o.Child = c.Name, true
				}
				options = append(options, o)
			}
		}
	}
	return options
}

// Select is the input name picking one of options, searched by typing. It holds the
// option of selected, or else the first Empty one. attrs are added to the search input.
templ Select(name string, options []SelectOption, selected string, attrs templ.Attributes) {
	{{
		value, label := "", ""
		if i := slices.IndexFunc(options, func(o SelectOption) bool { return o.Empty }); i >= 0 {
			value, label = options[i].Value, options[i].Label
		}
		if i := slices.IndexFunc(options, func(o SelectOption) bool { return o.Value == selected }); i >= 0 {
			value, label = options[i].Value, options[i].Label
		}
	}}
	<div data-select>
		<input type="hidden" name={ name } value={ value }/>
		<input
			type="text"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			value={ label }
			{ attrs... }
		/>
		<ul role="listbox" popover="manual">
			for i, o := range options {
				if o.Group != "" && (i == 0 || options[i-1].Group != o.Group) {
					<li role="presentation" data-group>{ o.Group }</li>
				}
				<li
					role="option"
					data-value={ o.Value }
					data-label={ o.Label }
					data-child?={ o.Child }
					data-empty?={ o.Empty }
				>{ cmp.Or(o.Text, o.Label) }</li>
			}
		</ul>
	</div>
}

// MultiSelect is Select picking any of options: each is a checkbox name, checked when
// its value is one of selected. The search input lists the picked ones by their Text,
// or placeholder when none is; attrs are added to it.
templ MultiSelect(name string, options []SelectOption, selected []string, placeholder string, attrs templ.Attributes) {
	{{
		var labels []string
		for _, o := range options {
			if slices.Contains(selected, o.Value) {
				labels = append(labels, cmp.Or(o.Text, o.Label))
			}
		}
	}}
	<div data-select data-multiple>
		<input
			type="text"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			value={ strings.Join(labels, ", ") }
			placeholder={ placeholder }
			{ attrs... }
		/>
		<ul role="listbox" aria-multiselectable="true" popover="manual">
			for i, o := range options {
				if o.Group != "" && (i == 0 || options[i-1].Group != o.Group) {
					<li role="presentation" data-group>{ o.Group }</li>
				}
				<li
					role="option"
					data-value={ o.Value }
					data-label={ o.Label }
					data-child?={ o.Child }
				>
					<input type="checkbox" name={ name } value={ o.Value } checked?={ slices.Contains(selected, o.Value) } tabindex="-1"/> { cmp.Or(o.Text, o.Label) }
				</li>
			}
		</ul>
	</div>
}

// TagInput is the input name of the comma separated tags of value, the tag being typed
// completed from all. attrs are added to it.
templ TagInput(name, value string, all []string, placeholder string, attrs templ.Attributes) {
	<div data-tags>
		<input
			type="text"
			name={ name }
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			value={ value }
			placeholder={ placeholder }
			{ attrs... }
		/>
		<ul role="listbox" popover="manual">
			for _, t := range all {
				<li role="option" data-label={ t }>{ t }</li>
			}
		</ul>
	</div>
}
