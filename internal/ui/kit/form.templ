package kit

import (
	"slices"
	"strconv"
	"strings"

	"github.com/ysomad/gigafin/internal/domain"
)

// Field is a form field: a label of class with the input as children, followed by
// the message err about it, with id errID when set. attrs are added to the label.
templ Field(class, label, err, errID string, attrs templ.Attributes) {
	<label
		data-field
		class={ templ.KV(class, class != "") }
		if err != "" {
			aria-invalid="true"
		}
		{ attrs... }
	>
		{ label }
		{ children... }
		@FieldError(err, errID)
	</label>
}

// FieldError is the message err about an input, with id errID when set.
templ FieldError(err, errID string) {
	if err != "" {
		<div
			if errID != "" {
				id={ errID }
			}
			class="error"
			role="status"
		>{ err }</div>
	}
}

// FormError is the message msg about a whole form, in grid column col, if any.
templ FormError(msg, col string) {
	if msg != "" {
		<p class={ templ.KV(col, col != ""), "error" } role="alert">{ msg }</p>
	}
}

// SubmitColumn is the submit button of a one-row form in a column of class, under an
// empty caption, so it lines up with the inputs under their labels.
templ SubmitColumn(class, variant, label string) {
	<div class={ class, "vstack gap-1" }>
		<label aria-hidden="true">&nbsp;</label>
		<div>
			<button
				type="submit"
				if variant != "" {
					data-variant={ variant }
				}
			>{ label }</button>
		</div>
	</div>
}

// RemoveColumn is the button labeled label removing a row of a form, in the last column
// of the row under an empty caption, so it lines up with the inputs. attrs make it
// remove the row.
templ RemoveColumn(label string, attrs templ.Attributes) {
	<div class="col-1 vstack gap-1">
		<label aria-hidden="true">&nbsp;</label>
		<div><button type="button" class="outline" aria-label={ label } title={ label } data-variant="secondary" { attrs... }>✕</button></div>
	</div>
}

// LinkButton is a link that looks like an outline button of variant.
templ LinkButton(href, variant, label string) {
	<a class="button outline" href={ href } data-variant={ variant }>{ label }</a>
}

// SegmentLink is a link of a group of links to the variants of a page, filled when
// current.
templ SegmentLink(href string, current bool, label string) {
	<a
		class={ "button", templ.KV("outline", !current) }
		if current {
			aria-current="page"
		}
		href={ href }
		data-variant="secondary"
	>{ label }</a>
}

// CurrencySelect picks one of currencies.
templ CurrencySelect(currencies []string, selected, err string) {
	<select name="currency" { Invalid(err, "currency-error")... }>
		for _, c := range currencies {
			<option selected?={ c == selected }>{ c }</option>
		}
	</select>
}

// CategoryChoice is an option of CategorySelect besides the categories, such as "All".
type CategoryChoice struct {
	Value string
	Label string
}

// CategorySelect is the input name picking a category of tree, searched by typing, or
// one of choices before them. It holds selected, the choice of that value, or else the
// first choice. Archived categories are left out, unless selected or archived is set.
// The categories of a tree of several kinds are grouped under their kind. attrs are
// added to the search input.
templ CategorySelect(name string, tree []domain.Category, selected int64, choices []CategoryChoice, archived bool, attrs templ.Attributes) {
	{{
		value, label := "", ""
		if len(choices) > 0 {
			value, label = choices[0].Value, choices[0].Label
		}
		for _, c := range choices {
			if c.Value == strconv.FormatInt(selected, 10) {
				value, label = c.Value, c.Label
			}
		}
		if name, ok := domain.CategoryNames(tree)[selected]; ok {
			value, label = strconv.FormatInt(selected, 10), name
		}
		grouped := len(tree) > 0 && tree[0].Kind != tree[len(tree)-1].Kind
	}}
	<div data-category-select>
		<input type="hidden" name={ name } value={ value }/>
		<input
			type="text"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			value={ label }
			{ attrs... }
		/>
		<ul role="listbox" popover="manual">
			for _, c := range choices {
				<li role="option" data-value={ c.Value } data-label={ c.Label }>{ c.Label }</li>
			}
			for i, parent := range tree {
				if grouped && (i == 0 || tree[i-1].Kind != parent.Kind) {
					<li role="presentation" data-group>{ KindLabel(ctx, parent.Kind) }</li>
				}
				if archived || !parent.Archived || parent.ID == selected {
					<li role="option" data-value={ parent.ID } data-kind={ string(parent.Kind) } data-label={ parent.Name }>{ parent.Name }</li>
				}
				for _, c := range parent.Children {
					if archived || !c.Archived || c.ID == selected {
						<li
							role="option"
							data-value={ c.ID }
							data-kind={ string(parent.Kind) }
							data-label={ parent.Name + " / " + c.Name }
							data-child
						>{ c.Name }</li>
					}
				}
			}
		</ul>
	</div>
}

// CategoryMultiSelect is CategorySelect picking any of choices and categories of tree,
// archived ones too: each option is a checkbox name, checked when its value is one of
// selected. The search input lists the picked ones by their own names, or placeholder
// when none is; attrs are added to it.
templ CategoryMultiSelect(
	name string, tree []domain.Category, selected []int64, choices []CategoryChoice, placeholder string,
	attrs templ.Attributes,
) {
	{{
		var labels []string
		picked := func(value string) bool {
			id, err := strconv.ParseInt(value, 10, 64)
			return err == nil && slices.Contains(selected, id)
		}
		for _, c := range choices {
			if picked(c.Value) {
				labels = append(labels, c.Label)
			}
		}
		for _, parent := range tree {
			if slices.Contains(selected, parent.ID) {
				labels = append(labels, parent.Name)
			}
			for _, c := range parent.Children {
				if slices.Contains(selected, c.ID) {
					labels = append(labels, c.Name)
				}
			}
		}
		grouped := len(tree) > 0 && tree[0].Kind != tree[len(tree)-1].Kind
	}}
	<div data-category-select data-multiple>
		<input
			type="text"
			role="combobox"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			value={ strings.Join(labels, ", ") }
			placeholder={ placeholder }
			{ attrs... }
		/>
		<ul role="listbox" aria-multiselectable="true" popover="manual">
			for _, c := range choices {
				<li role="option" data-value={ c.Value } data-label={ c.Label }>
					<input type="checkbox" name={ name } value={ c.Value } checked?={ picked(c.Value) } tabindex="-1"/> { c.Label }
				</li>
			}
			for i, parent := range tree {
				if grouped && (i == 0 || tree[i-1].Kind != parent.Kind) {
					<li role="presentation" data-group>{ KindLabel(ctx, parent.Kind) }</li>
				}
				<li role="option" data-value={ parent.ID } data-kind={ string(parent.Kind) } data-label={ parent.Name }>
					<input type="checkbox" name={ name } value={ parent.ID } checked?={ slices.Contains(selected, parent.ID) } tabindex="-1"/> { parent.Name }
				</li>
				for _, c := range parent.Children {
					<li
						role="option"
						data-value={ c.ID }
						data-kind={ string(parent.Kind) }
						data-label={ domain.FullName(parent.Name, c.Name) }
						data-child
					>
						<input type="checkbox" name={ name } value={ c.ID } checked?={ slices.Contains(selected, c.ID) } tabindex="-1"/> { c.Name }
					</li>
				}
			}
		</ul>
	</div>
}
