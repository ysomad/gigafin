package kit

import (
	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/web"
)

// Layout is the page of v around children: toTop adds the scroll-to-top button, toasts
// more toasts after those of v. A theme set by the user overrides the color-scheme of
// Oat, which else follows the system.
templ Layout(v Page, toTop bool, toasts templ.Component) {
	{{ theme := PrefsFrom(ctx).Settings.Theme }}
	<!DOCTYPE html>
	<html
		lang={ Lang(ctx) }
		if theme == domain.ThemeLight {
			style="color-scheme: light"
		}
		if theme == domain.ThemeDark {
			style="color-scheme: dark"
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			// theme-color is Oat's background, tinting the browser and installed app bars
			switch theme {
				case domain.ThemeAuto:
					<meta name="color-scheme" content="light dark"/>
					<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
					<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)"/>
				case domain.ThemeDark:
					<meta name="color-scheme" content={ string(theme) }/>
					<meta name="theme-color" content="#09090b"/>
				default:
					<meta name="color-scheme" content={ string(theme) }/>
					<meta name="theme-color" content="#ffffff"/>
			}
			<link rel="manifest" href="/static/manifest.json"/>
			<link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png"/>
			<link rel="icon" href="/static/img/icon-192.png"/>
			<meta name="htmx-config" content='{"defaultSwap":"innerHTML"}'/>
			<title>{ v.Title }</title>
			// ?v= makes browsers load the files anew once they change, see web.Version
			// not deferred: it hides amounts before they are drawn
			<script src={ "/static/js/privacy.js?v=" + web.Version }></script>
			<link rel="stylesheet" href={ "/static/dist/app.min.css?v=" + web.Version }/>
			<script src={ "/static/lib/htmx.min.js?v=" + web.Version } defer></script>
			<script src={ "/static/lib/hx-history-cache.min.js?v=" + web.Version } defer></script>
			<script src={ "/static/lib/uplot.min.js?v=" + web.Version } defer></script>
			<script src={ "/static/lib/oat.min.js?v=" + web.Version } defer></script>
			<script src={ "/static/dist/app.min.js?v=" + web.Version } defer></script>
		</head>
		// boosted links and forms swap only main and the nav, keeping the body, its header
		// and listeners; the page scrolls to the top as it did when the body was swapped
		<body id="top" hx-boost:inherited='{"swap":"outerSync show:top showTarget:body","target":"#main","select":"#main","selectOOB":"#topnav"}'>
			<header id="topnav" data-topnav>
				<nav class="container hstack justify-between">
					<a href="/" class="unstyled brand"><strong>GIGAFIN</strong></a>
					if v.User != nil {
						<div class="hstack gap-1">
							@navLink("/", v.Nav == "analytics", T(ctx, "Analytics"))
							@navLink("/operations", v.Nav == "operations", T(ctx, "Operations"))
							@navLink("/accounts", v.Nav == "accounts", T(ctx, "Accounts"))
							@navLink("/plans", v.Nav == "plans", T(ctx, "Plans"))
							<button type="button" class="button small ghost" data-privacy-toggle aria-pressed="false" aria-label={ T(ctx, "Hide amounts") }>
								<svg data-icon="eye" width="18" height="18" aria-hidden="true"><use href="/static/img/icons.svg#eye"></use></svg>
								<svg data-icon="eye-off" width="18" height="18" aria-hidden="true"><use href="/static/img/icons.svg#eye-off"></use></svg>
							</button>
							@navLink("/settings", v.Nav == "settings", "...")
						</div>
					}
				</nav>
			</header>
			<main id="main" class="container mb-8">
				if v.BankSync {
					<div id="bank-sync" hx-post="/settings/banks/autosync" hx-trigger="load" hx-swap="outerHTML"></div>
				}
				{ children... }
				// the operations of OpRows are edited in, opened by app.js once the form is
				// swapped in, or with the page that has its Dialog
				<dialog id="op-dialog" closedby="any" aria-label={ T(ctx, "Operation") } autofocus open?={ v.Dialog != nil }>
					if v.Dialog != nil {
						@v.Dialog
					}
				</dialog>
				if toTop {
					<a class="button outline to-top" href="#top" hx-boost="false" hidden aria-label={ T(ctx, "Scroll to top") }>↑</a>
				}
				// after the content, whose inputs take their field messages first
				@Toasts(v, false, toasts)
			</main>
		</body>
	</html>
}

// DialogHeader is the header of the modal dialog of id, as Oat lays out a dialog: a header,
// a body scrolling between and a footer of buttons, Save or Apply last. It shows title,
// a button closing the dialog and children under them. Every modal dialog has one. A
// step of a dialog, such as a split opened from the edit of an operation, has back, the
// step before it, which the button returns to instead, as Escape does, see app.js.
templ DialogHeader(id, title, back string) {
	<header>
		<div class="hstack justify-between">
			<h3>{ title }</h3>
			if back != "" {
				<button type="button" class="ghost small" hx-get={ back } hx-target={ "#" + id } hx-swap="innerHTML" data-dialog-back aria-label={ T(ctx, "Close") }><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#x"></use></svg></button>
			} else {
				<button type="button" class="ghost small" commandfor={ id } command="close" aria-label={ T(ctx, "Close") }><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#x"></use></svg></button>
			}
		</div>
		{ children... }
	</header>
}

templ navLink(href string, current bool, label string) {
	<a
		href={ href }
		if current {
			aria-current="page"
		}
	>{ label }</a>
}

// Toasts are the toasts of the errors and notice of v, then extra: oob marks them for
// htmx to swap in out of band.
templ Toasts(v Page, oob bool, extra templ.Component) {
	<div
		id="toasts"
		hidden
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, msg := range v.Errors.Toasts() {
			@Toast("danger", msg)
		}
		if v.Notice != "" {
			@Toast("success", v.Notice)
		}
		if extra != nil {
			@extra
		}
	</div>
}

// Toast is the message msg of variant.
templ Toast(variant, msg string) {
	<output class="toast" data-variant={ variant }><p>{ msg }</p></output>
}

// NotFound is the page of a missing resource.
templ NotFound(v Page, _ struct{}) {
	@Layout(v, false, nil) {
		<h1>{ T(ctx, "Not found") }</h1>
		<p><a href="/">{ T(ctx, "Back to analytics") }</a></p>
	}
}
