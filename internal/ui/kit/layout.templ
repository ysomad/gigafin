package kit

import "github.com/ysomad/gigafin/internal/domain"

// Layout is the page of v around children: toTop adds the scroll-to-top button, toasts
// more toasts after those of v. A theme set by the user overrides the color-scheme of
// Oat, which else follows the system.
templ Layout(v Page, toTop bool, toasts templ.Component) {
	{{ theme := PrefsFrom(ctx).Settings.Theme }}
	<!DOCTYPE html>
	<html
		lang={ Lang(ctx) }
		if theme == domain.ThemeLight {
			style="color-scheme: light"
		}
		if theme == domain.ThemeDark {
			style="color-scheme: dark"
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			// theme-color is Oat's background, tinting the browser and installed app bars
			switch theme {
				case domain.ThemeAuto:
					<meta name="color-scheme" content="light dark"/>
					<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
					<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)"/>
				case domain.ThemeDark:
					<meta name="color-scheme" content={ string(theme) }/>
					<meta name="theme-color" content="#09090b"/>
				default:
					<meta name="color-scheme" content={ string(theme) }/>
					<meta name="theme-color" content="#ffffff"/>
			}
			<link rel="manifest" href="/static/manifest.json"/>
			<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
			<link rel="icon" href="/static/icon-192.png"/>
			<meta name="htmx-config" content='{"defaultSwap":"innerHTML"}'/>
			<title>{ v.Title } · gigafin</title>
			<link rel="stylesheet" href="/static/lib/oat.min.css"/>
			<link rel="stylesheet" href="/static/lib/uplot.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/lib/htmx.min.js" defer></script>
			<script src="/static/lib/uplot.min.js" defer></script>
			<script src="/static/lib/oat.min.js" defer></script>
			<script src="/static/operation-tags.js" defer></script>
			<script src="/static/analytics.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body id="top" hx-boost:inherited="true">
			<header data-topnav>
				<nav class="container hstack justify-between">
					<a href="/" class="unstyled brand"><strong>GIGAFIN</strong></a>
					if v.User != nil {
						<div class="hstack gap-1">
							@navLink("/", v.Nav == "analytics", T(ctx, "Analytics"))
							@navLink("/operations", v.Nav == "operations", T(ctx, "Operations"))
							@navLink("/accounts", v.Nav == "accounts", T(ctx, "Accounts"))
							@navLink("/plans", v.Nav == "plans", T(ctx, "Plans"))
							@navLink("/settings", v.Nav == "settings", "...")
						</div>
					}
				</nav>
			</header>
			<main class="container mb-8">
				if v.BankSync {
					<div id="bank-sync" hx-post="/settings/banks/autosync" hx-trigger="load" hx-swap="outerHTML"></div>
				}
				{ children... }
				if toTop {
					<a class="button to-top" href="#top" hx-boost="false" hidden aria-label={ T(ctx, "Scroll to top") }>↑</a>
				}
				// after the content, whose inputs take their field messages first
				@Toasts(v, false, toasts)
			</main>
		</body>
	</html>
}

templ navLink(href string, current bool, label string) {
	<a
		href={ href }
		class={ "button small", templ.KV("outline", current), templ.KV("ghost", !current) }
		if current {
			aria-current="page"
		}
	>{ label }</a>
}

// Toasts are the toasts of the errors and notice of v, then extra: oob marks them for
// htmx to swap in out of band.
templ Toasts(v Page, oob bool, extra templ.Component) {
	<div
		id="toasts"
		hidden
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, msg := range v.Errors.Toasts() {
			@Toast("danger", msg)
		}
		if v.Notice != "" {
			@Toast("success", v.Notice)
		}
		if extra != nil {
			@extra
		}
	</div>
}

// Toast is the message msg of variant.
templ Toast(variant, msg string) {
	<output class="toast" data-variant={ variant }><p>{ msg }</p></output>
}

// NotFound is the page of a missing resource.
templ NotFound(v Page, _ struct{}) {
	@Layout(v, false, nil) {
		<h1>{ T(ctx, "Not found") }</h1>
		<p><a href="/">{ T(ctx, "Back to analytics") }</a></p>
	}
}
