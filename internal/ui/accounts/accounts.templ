package accounts

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/money"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ accountsPage(v kit.Page, d accountsData) {
	@kit.Layout(v, false, nil) {
		<div class="hstack mb-4">
			@kit.NewButton("/accounts/new", kit.T(ctx, "Account"), nil)
		</div>
		if len(d.Assets) == 0 && len(d.Liabilities) == 0 && len(d.Archived) == 0 {
			<p class="text-light">{ kit.T(ctx, "No accounts yet.") }</p>
		}
		if len(d.Assets) > 0 {
			<ul class="unstyled vstack gap-1">
				for _, a := range d.Assets {
					<li class="card compact hstack justify-between">
						<a href={ fmt.Sprintf("/accounts/%d", a.ID) }>
							<div class="hstack gap-1">
								if t, ok := d.Banks[a.ID]; ok {
									@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
								}
								{ a.Name }
								if t, ok := d.Banks[a.ID]; ok && t.Mismatch(a) {
									@kit.BankBadge(t, a)
								}
							</div>
							<small class="text-light">{ kit.T(ctx, string(a.Kind)) }</small>
						</a>
						<div class="align-right"><span data-amount>{ kit.Money(ctx, a.Balance, a.Currency) } <span class="text-light">{ money.CurrencySymbol(a.Currency) }</span></span></div>
					</li>
				}
			</ul>
		}
		if len(d.Liabilities) > 0 {
			<h2>{ kit.T(ctx, "Credit and loans") }</h2>
			<ul class="unstyled vstack gap-1">
				for _, a := range d.Liabilities {
					<li class="card compact hstack justify-between">
						<a href={ fmt.Sprintf("/accounts/%d", a.ID) }>
							<div class="hstack gap-1">
								if t, ok := d.Banks[a.ID]; ok {
									@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
								}
								{ a.Name }
								if t, ok := d.Banks[a.ID]; ok && t.Mismatch(a) {
									@kit.BankBadge(t, a)
								}
							</div>
							<small class="text-light">{ kit.T(ctx, string(a.Kind)) }</small>
						</a>
						<div class="align-right">
							<div><span data-amount>{ kit.Money(ctx, a.Owed(), a.Currency) } <span class="text-light">{ money.CurrencySymbol(a.Currency) }</span></span></div>
							if !a.CreditLimit.IsZero() {
								<small class="text-light">{ kit.T(ctx, "Available") } <span data-amount>{ kit.Money(ctx, a.Available(), a.Currency) } <span class="text-light">{ money.CurrencySymbol(a.Currency) }</span></span></small>
							}
						</div>
					</li>
				}
			</ul>
		}
		if len(d.Archived) > 0 {
			<details class="mt-4">
				<summary><span>{ kit.T(ctx, "Archived") } <span class="text-light">{ len(d.Archived) }</span></span></summary>
				<ul class="unstyled vstack gap-1">
					for _, a := range d.Archived {
						<li class="card compact hstack justify-between">
							<a href={ fmt.Sprintf("/accounts/%d", a.ID) }>
								<div class="hstack gap-1">
									if t, ok := d.Banks[a.ID]; ok {
										@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
									}
									{ a.Name }
								</div>
								<small class="text-light">{ kit.T(ctx, string(a.Kind)) }</small>
							</a>
							<div class="align-right"><span data-amount>{ kit.Money(ctx, a.Balance, a.Currency) } <span class="text-light">{ money.CurrencySymbol(a.Currency) }</span></span></div>
						</li>
					}
				</ul>
			</details>
		}
	}
}

templ accountPage(v kit.Page, d accountData) {
	{{
		a, f := d.Account, d.Edit
		base := fmt.Sprintf("/accounts/%d", a.ID)
	}}
	@kit.Layout(v, false, nil) {
		<div class="hstack justify-between mb-4">
			<div class="hstack">
				if d.Linked.ID != 0 {
					@kit.BankLogo(d.Linked.Bank, kit.T(ctx, d.Linked.Bank.Name())+" · "+d.Linked.Name)
				}
				<h1>{ a.Name }</h1>
				<span class="badge outline">{ kit.T(ctx, string(a.Kind)) }</span>
				if a.Archived {
					@kit.ArchivedBadge()
				}
			</div>
			<div class="hstack">
				if d.Linked.Mismatch(a) {
					@kit.BankBadge(d.Linked, a)
				}
				<h2 aria-label={ kit.T(ctx, "Balance") }><span data-amount>{ kit.Money(ctx, a.Balance, a.Currency) } <span class="text-light">{ money.CurrencySymbol(a.Currency) }</span></span></h2>
			</div>
		</div>
		if !a.CreditLimit.IsZero() {
			<div class="mb-4">
				<progress value={ a.Owed().Fixed(a.Currency) } max={ a.CreditLimit.Fixed(a.Currency) } aria-label={ kit.T(ctx, "Owed") }></progress>
				<div class="hstack justify-between text-light">
					<span data-amount>{ kit.T(ctx, "owed %s", kit.Money(ctx, a.Owed(), a.Currency)) }</span>
					<span data-amount>{ kit.T(ctx, "available %s of %s", kit.Money(ctx, a.Available(), a.Currency), kit.Money(ctx, a.CreditLimit, a.Currency)) }</span>
				</div>
			</div>
		}
		<article class="card mb-4 form-compact">
			<h3>{ kit.T(ctx, "Set balance") }</h3>
			<form id="form-balance" method="post" action={ base + "/balance" } class="row">
				@kit.FormError(v.Errors.Form("balance"), "col-12")
				{{ e := v.Errors.Get("balance") }}
				@kit.Field("col-3", kit.T(ctx, "New balance"), e, "balance-error", nil) {
					<input name="balance" inputmode="decimal" value={ kit.AmountInput(ctx, d.Balance.Target) } { kit.Invalid(e, "balance-error")... }/>
				}
				{{ e = v.Errors.Get("date") }}
				@kit.Field("col-3", kit.T(ctx, "As of"), e, "date-error", nil) {
					<input type="date" name="date" value={ d.Balance.Date } { kit.Invalid(e, "date-error")... }/>
				}
				@kit.SubmitColumn("col-3", "", kit.T(ctx, "Set"))
			</form>
		</article>
		<article class="card mb-4 form-compact">
			<div class="hstack justify-between">
				<h3>{ kit.T(ctx, "Settings") }</h3>
				@kit.ArchiveDelete("account", a.Archived)
			</div>
			<form id="form-edit" method="post" action={ base } class="row" hx-disable="find button">
				@kit.FormError(v.Errors.Form("edit"), "col-12")
				{{ e = v.Errors.Get("name") }}
				@kit.Field("col-3", kit.T(ctx, "Name"), e, "name-error", nil) {
					<input name="name" value={ f.Name } { kit.Invalid(e, "name-error")... }/>
				}
				if a.Kind.IsCredit() {
					{{ e = v.Errors.Get("credit_limit") }}
					@kit.Field("col-3", kit.T(ctx, "Credit limit"), e, "credit-limit-error", nil) {
						<input name="credit_limit" inputmode="decimal" value={ kit.AmountInput(ctx, f.CreditLimit) } { kit.Invalid(e, "credit-limit-error")... }/>
					}
				}
				@kit.SubmitColumn("col-3", "", kit.T(ctx, "Save"))
			</form>
			@kit.ArchiveDeleteForms("account", base, a.Archived, kit.T(ctx, "Delete account %s?", a.Name))
		</article>
		<div class="hstack justify-between">
			<h2>{ kit.T(ctx, "Operations") }</h2>
			<a class="button outline" href={ fmt.Sprintf("/operations?account=%d", a.ID) } aria-label={ kit.T(ctx, "Filter") }><svg width="16" height="16" aria-hidden="true"><use href="/static/img/icons.svg#funnel"></use></svg></a>
		</div>
		if len(d.Days) > 0 {
			<ul class="unstyled vstack gap-1">
				@kit.OpRows(d.Days, d.CatNames, d.AccByID, d.MoreURL)
			</ul>
		} else {
			@kit.NoOperations()
		}
	}
}

templ newAccountPage(v kit.Page, d newAccountData) {
	{{ f := d.Form }}
	@kit.Layout(v, false, nil) {
		<h1>{ kit.T(ctx, "New account") }</h1>
		<form id="form-account" class="form-compact" method="post" action="/accounts" hx-disable="find button">
			@kit.FormError(v.Errors.Form("account"), "")
			<fieldset class="row mb-4" aria-label={ kit.T(ctx, "Account") }>
				{{ e := v.Errors.Get("name") }}
				@kit.Field("col-12", kit.T(ctx, "Name"), e, "name-error", nil) {
					<input name="name" value={ f.Name } { kit.Invalid(e, "name-error")... }/>
				}
				{{ e = v.Errors.Get("kind") }}
				@kit.Field("col-6", kit.T(ctx, "Kind"), e, "kind-error", nil) {
					@kindSelect(d.Kinds, f.Kind, e)
				}
				{{ e = v.Errors.Get("currency") }}
				@kit.Field("col-6", kit.T(ctx, "Currency"), e, "currency-error", nil) {
					@kit.CurrencySelect(d.Currencies, f.Currency, e)
				}
				{{ e = v.Errors.Get("balance") }}
				@kit.Field("col-6", kit.T(ctx, "Opening balance"), e, "balance-error", nil) {
					<input name="balance" inputmode="decimal" placeholder="0" value={ kit.AmountInput(ctx, f.Balance) } { kit.Invalid(e, "balance-error")... }/>
				}
				@creditLimitField("col-6", f.Kind, f.CreditLimit, v.Errors.Get("credit_limit"))
			</fieldset>
			<div class="hstack">
				<button type="submit">{ kit.T(ctx, "Create") }</button>
			</div>
		</form>
	}
}

// kindSelect picks the kind of an account, shows and hides the credit limit
// field by app.js.
templ kindSelect(kinds []domain.AccountKind, selected, err string) {
	<select name="kind" data-account-kind { kit.Invalid(err, "kind-error")... }>
		for _, k := range kinds {
			<option value={ string(k) } selected?={ string(k) == selected }>{ kit.T(ctx, string(k)) }</option>
		}
	</select>
}

// creditLimitField is the credit limit of an account of kind, hidden and disabled
// unless a credit card.
templ creditLimitField(class, kind, value, err string) {
	{{ credit := domain.AccountKind(kind).IsCredit() }}
	@kit.Field(class, kit.T(ctx, "Credit limit"), err, "credit-limit-error", templ.Attributes{"data-credit-limit": true, "hidden": !credit}) {
		<input name="credit_limit" inputmode="decimal" value={ kit.AmountInput(ctx, value) } disabled?={ !credit } { kit.Invalid(err, "credit-limit-error")... }/>
	}
}
