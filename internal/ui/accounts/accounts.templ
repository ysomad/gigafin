package accounts

import (
	"fmt"

	"github.com/ysomad/gigafin/internal/domain"
	"github.com/ysomad/gigafin/internal/ui/kit"
)

templ accountsPage(v kit.Page, d accountsData) {
	@kit.Layout(v, false, nil) {
		<div class="hstack mb-4">
			<a class="button" href="/accounts/new">+ { kit.T(ctx, "New account") }</a>
		</div>
		if len(d.Assets) == 0 && len(d.Liabilities) == 0 {
			<p class="text-light">{ kit.T(ctx, "No accounts yet.") }</p>
		}
		if len(d.Assets) > 0 {
			<div class="table">
				<table>
					<thead><tr><th>{ kit.T(ctx, "Name") }</th><th>{ kit.T(ctx, "Kind") }</th><th class="align-right">{ kit.T(ctx, "Balance") }</th></tr></thead>
					<tbody>
						for _, a := range d.Assets {
							<tr>
								<td>
									<div class="hstack gap-1">
										<a href={ fmt.Sprintf("/accounts/%d", a.ID) }>{ a.Name }</a>
										if t, ok := d.Banks[a.ID]; ok {
											@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
										}
										if a.Archived {
											@kit.ArchivedBadge()
										}
										if t, ok := d.Banks[a.ID]; ok && t.Mismatch(a) {
											@kit.BankBadge(t, a, false)
										}
									</div>
								</td>
								<td>{ kit.T(ctx, string(a.Kind)) }</td>
								<td class="align-right">{ kit.Money(ctx, a.Balance, a.Currency) } <span class="text-light">{ a.Currency }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if len(d.Liabilities) > 0 {
			<h2>{ kit.T(ctx, "Credit and loans") }</h2>
			<div class="table">
				<table>
					<thead><tr><th>{ kit.T(ctx, "Name") }</th><th>{ kit.T(ctx, "Kind") }</th><th class="align-right">{ kit.T(ctx, "Owed") }</th><th class="align-right">{ kit.T(ctx, "Available") }</th></tr></thead>
					<tbody>
						for _, a := range d.Liabilities {
							<tr>
								<td>
									<div class="hstack gap-1">
										<a href={ fmt.Sprintf("/accounts/%d", a.ID) }>{ a.Name }</a>
										if t, ok := d.Banks[a.ID]; ok {
											@kit.BankLogo(t.Bank, kit.T(ctx, t.Bank.Name())+" · "+t.Name)
										}
										if a.Archived {
											@kit.ArchivedBadge()
										}
										if t, ok := d.Banks[a.ID]; ok && t.Mismatch(a) {
											@kit.BankBadge(t, a, false)
										}
									</div>
								</td>
								<td>{ kit.T(ctx, string(a.Kind)) }</td>
								<td class="align-right">{ kit.Money(ctx, a.Owed(), a.Currency) } <span class="text-light">{ a.Currency }</span></td>
								<td class="align-right">
									if !a.CreditLimit.IsZero() {
										{ kit.Money(ctx, a.Available(), a.Currency) } <span class="text-light">{ a.Currency }</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ accountPage(v kit.Page, d accountData) {
	{{
		a, f := d.Account, d.Edit
		base := fmt.Sprintf("/accounts/%d", a.ID)
	}}
	@kit.Layout(v, false, nil) {
		<div class="hstack mb-4">
			<h1>{ a.Name }</h1>
			<span class="badge outline">{ kit.T(ctx, string(a.Kind)) }</span>
			if d.Linked.ID != 0 {
				<span class="badge outline hstack gap-1">
					@kit.BankLogo(d.Linked.Bank, kit.T(ctx, d.Linked.Bank.Name()))
					{ d.Linked.Name }
				</span>
			}
			if a.Archived {
				@kit.ArchivedBadge()
			}
		</div>
		<article class="card mb-4">
			<div class="hstack justify-between">
				<div>
					<div class="text-light">{ kit.T(ctx, "Balance") }</div>
					<h2>{ kit.Money(ctx, a.Balance, a.Currency) } <span class="text-light">{ a.Currency }</span></h2>
				</div>
				if d.Linked.Mismatch(a) {
					@kit.BankBadge(d.Linked, a, false)
				}
			</div>
			if !a.CreditLimit.IsZero() {
				<progress class="mt-2" value={ a.Owed().Fixed(a.Currency) } max={ a.CreditLimit.Fixed(a.Currency) } aria-label={ kit.T(ctx, "Owed") }></progress>
				<div class="hstack justify-between text-light">
					<span>{ kit.T(ctx, "owed %s", kit.Money(ctx, a.Owed(), a.Currency)) }</span>
					<span>{ kit.T(ctx, "available %s of %s", kit.Money(ctx, a.Available(), a.Currency), kit.Money(ctx, a.CreditLimit, a.Currency)) }</span>
				</div>
			}
		</article>
		<details class="mb-2" open?={ d.Open == "edit" }>
			<summary>{ kit.T(ctx, "Settings") }</summary>
			<form id="form-edit" class="form-compact mt-2" method="post" action={ base } hx-disable="find button">
				@kit.FormError(v.Errors.Form("edit"), "")
				<fieldset class="row" aria-label={ kit.T(ctx, "Account") }>
					{{ e := v.Errors.Get("name") }}
					@kit.Field("col-4", kit.T(ctx, "Name"), e, "name-error", nil) {
						<input name="name" value={ f.Name } { kit.Invalid(e, "name-error")... }/>
					}
					{{ e = v.Errors.Get("kind") }}
					@kit.Field("col-4", kit.T(ctx, "Kind"), e, "kind-error", nil) {
						@kindSelect(d.Kinds, f.Kind, e)
					}
					@creditLimitField("col-4", f.Kind, f.CreditLimit, v.Errors.Get("credit_limit"))
				</fieldset>
				<div class="hstack justify-between">
					<button type="submit">{ kit.T(ctx, "Save") }</button>
					@kit.ArchiveDelete("account", a.Archived)
				</div>
			</form>
			@kit.ArchiveDeleteForms("account", base, a.Archived, kit.T(ctx, "Delete account %s?", a.Name))
		</details>
		<details class="mb-4" open?={ d.Open == "balance" }>
			<summary>{ kit.T(ctx, "Set balance") }</summary>
			<form id="form-balance" class="form-compact mt-2" method="post" action={ base + "/balance" }>
				@kit.FormError(v.Errors.Form("balance"), "")
				<fieldset class="row" aria-label={ kit.T(ctx, "Set balance") }>
					{{ e = v.Errors.Get("balance") }}
					@kit.Field("col-4", kit.T(ctx, "New balance"), e, "balance-error", nil) {
						<input name="balance" inputmode="decimal" value={ kit.AmountInput(ctx, d.Balance.Target) } { kit.Invalid(e, "balance-error")... }/>
					}
					{{ e = v.Errors.Get("date") }}
					@kit.Field("col-4", kit.T(ctx, "As of"), e, "date-error", nil) {
						<input type="date" name="date" value={ d.Balance.Date } { kit.Invalid(e, "date-error")... }/>
					}
					<div class="col-4 vstack gap-1">
						<label aria-hidden="true">&nbsp;</label>
						<div>
							<button type="submit">{ kit.T(ctx, "Set") }</button>
						</div>
					</div>
				</fieldset>
			</form>
		</details>
		<div class="hstack justify-between">
			<h2>{ kit.T(ctx, "Operations") }</h2>
			<a href={ fmt.Sprintf("/operations?account=%d", a.ID) }>{ kit.T(ctx, "Filter") }</a>
		</div>
		if len(d.Days) > 0 {
			<ul class="unstyled vstack gap-1">
				@kit.OpRows(d.Days, d.CatNames, d.AccByID, d.MoreURL)
			</ul>
		} else {
			@kit.NoOperations()
		}
	}
}

templ newAccountPage(v kit.Page, d newAccountData) {
	{{ f := d.Form }}
	@kit.Layout(v, false, nil) {
		<h1>{ kit.T(ctx, "New account") }</h1>
		<form id="form-account" class="form-compact" method="post" action="/accounts" hx-disable="find button">
			@kit.FormError(v.Errors.Form("account"), "")
			<fieldset class="row mb-4" aria-label={ kit.T(ctx, "Account") }>
				{{ e := v.Errors.Get("name") }}
				@kit.Field("col-12", kit.T(ctx, "Name"), e, "name-error", nil) {
					<input name="name" value={ f.Name } { kit.Invalid(e, "name-error")... }/>
				}
				{{ e = v.Errors.Get("kind") }}
				@kit.Field("col-6", kit.T(ctx, "Kind"), e, "kind-error", nil) {
					@kindSelect(d.Kinds, f.Kind, e)
				}
				{{ e = v.Errors.Get("currency") }}
				@kit.Field("col-6", kit.T(ctx, "Currency"), e, "currency-error", nil) {
					@kit.CurrencySelect(d.Currencies, f.Currency, e)
				}
				{{ e = v.Errors.Get("balance") }}
				@kit.Field("col-6", kit.T(ctx, "Opening balance"), e, "balance-error", nil) {
					<input name="balance" inputmode="decimal" placeholder="0" value={ kit.AmountInput(ctx, f.Balance) } { kit.Invalid(e, "balance-error")... }/>
				}
				@creditLimitField("col-6", f.Kind, f.CreditLimit, v.Errors.Get("credit_limit"))
			</fieldset>
			<div class="hstack">
				<button type="submit">{ kit.T(ctx, "Create") }</button>
				@kit.LinkButton("/accounts", "secondary", kit.T(ctx, "Cancel"))
			</div>
		</form>
	}
}

// kindSelect picks the kind of an account, shows and hides the credit limit
// field by app.js.
templ kindSelect(kinds []domain.AccountKind, selected, err string) {
	<select name="kind" data-account-kind { kit.Invalid(err, "kind-error")... }>
		for _, k := range kinds {
			<option value={ string(k) } selected?={ string(k) == selected }>{ kit.T(ctx, string(k)) }</option>
		}
	</select>
}

// creditLimitField is the credit limit of an account of kind, hidden and disabled
// unless a credit card.
templ creditLimitField(class, kind, value, err string) {
	{{ credit := kind == string(domain.AccountCredit) }}
	@kit.Field(class, kit.T(ctx, "Credit limit"), err, "credit-limit-error", templ.Attributes{"data-credit-limit": true, "hidden": !credit}) {
		<input name="credit_limit" inputmode="decimal" value={ kit.AmountInput(ctx, value) } disabled?={ !credit } { kit.Invalid(err, "credit-limit-error")... }/>
	}
}
